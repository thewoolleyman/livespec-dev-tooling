# RENDERED by ansible/roles/fabro_server_cpu_weight — do not edit this file on
# the host; change fabro_server_cpu_weight_value in the host's inventory host_vars and
# re-apply ansible/fabro-hosts.yml with --tags fabro_server_cpu_weight.
#
# The Fabro server competes for CPU with everything else under system.slice.
# Its weight is applied to the running unit's cgroup by a daemon-reload; it
# needs no restart, and the role that writes it never restarts the unit.
[Service]
