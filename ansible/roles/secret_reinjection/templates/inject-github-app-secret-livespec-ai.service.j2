{{ ansible_managed | comment }}
# inject-github-app-secret-livespec-ai.service — the ORGANIZATION projection of
# the ARC secret reinjection (livespec-dev-tooling-h5r75q): (re)writes
# arc-runners/arc-github-app-installation-livespec-ai from the livespec-ai-arc
# GitHub App credential that homelab's shared-credentials launcher reads from
# AWS SSM at launch. The k3s datastore is tmpfs, so this runs at every boot.
#
# ExecStartPre=+ runs as ROOT with the admin kubeconfig: it re-applies the
# projector's Role/RoleBinding (erased by the reboot), creates the EMPTY
# placeholder Secret when absent, keeps the projector's client-certificate
# kubeconfig current, and reads the grant back. ExecStart runs as the
# dedicated non-root {{ secret_reinjection_org_user }}: sudo (one fixed command, see
# /etc/sudoers.d/{{ secret_reinjection_org_user }}) starts the launcher, which drops back to
# this user for the injector. The personal-account Secret is the sibling
# inject-github-app-secret.service's and is never touched here.
[Unit]
Description=Project the livespec-ai-arc GitHub App credential into arc-runners/arc-github-app-installation-livespec-ai at boot
Requires=k3s.service
# The launcher reads AWS SSM, so the network must be up.
Wants=network-online.target
After=k3s.service network-online.target inject-github-app-secret.service
# Present before the converge that brings ARC up; harmless when that unit is absent.
Before=converge-ci-stack.service

[Service]
Type=oneshot
User={{ secret_reinjection_org_user }}
Group={{ secret_reinjection_org_user }}
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
ExecStartPre=+{{ secret_reinjection_lib_dir }}/ensure-arc-org-projector-access.sh
ExecStart=/usr/bin/sudo -n {{ secret_reinjection_org_launch_command }}

[Install]
WantedBy=multi-user.target
