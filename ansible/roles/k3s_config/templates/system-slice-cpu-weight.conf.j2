# RENDERED by ansible/roles/k3s_config — do not edit this file on the host;
# change k3s_config_system_slice_cpu_weight in the host's inventory host_vars
# and re-apply ansible/ci-pool.yml with --tags k3s_system_slice_cpu_weight.
#
# system.slice holds the k3s unit (with its embedded containerd and kubelet) and
# competes at the cgroup ROOT against kubepods.slice, whose weight kubelet
# derives from allocatable CPU. A daemon-reload applies this weight to the
# running slice; nothing restarts. It is a share, never a pin: no CPU is held
# idle for system.slice.
[Slice]
CPUWeight={{ k3s_config_system_slice_cpu_weight }}
