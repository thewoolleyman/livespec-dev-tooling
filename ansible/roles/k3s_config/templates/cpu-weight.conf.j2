# RENDERED by ansible/roles/k3s_config — do not edit this file on the host;
# change k3s_config_cpu_weight in the host's inventory host_vars and re-apply
# ansible/ci-pool.yml with --tags k3s_cpu_weight.
#
# The k3s unit carries the kubelet and competes for CPU with everything else
# under system.slice. Its weight is applied to the running unit's cgroup by a
# daemon-reload; it needs no restart, and the role never restarts k3s.
[Service]
CPUWeight={{ k3s_config_cpu_weight }}
