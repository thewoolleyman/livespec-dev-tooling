# RENDERED by ansible/roles/k3s_config — do not edit this file on the host; edit
# the node's committed profile under
# ci-runner/k3s/phase0-bare-metal/profiles/ and re-apply ansible/ci-pool.yml.
#
# This agent's node taints, rendered from the records its profile declares in
# NODE_TAINTS. k3s merges every file in /etc/rancher/k3s/config.yaml.d/ over
# /etc/rancher/k3s/config.yaml and reads the result on EVERY start, so THIS
# file — not the unit's command line — is what the node re-registers with after
# a control-plane reboot recreates the cluster's objects.
#
# WHY THE LIST IS STATED EVEN WHEN IT IS EMPTY. An empty list says "this node is
# open", which is the fact a re-registration has to read; a file that merely
# omitted the key would leave the answer to whatever carrier happened to survive
# — which is the defect this file exists to end (livespec-dev-tooling-yapwva).
node-taint: {{ k3s_config_node_taint_records }}
