# RENDERED by ansible/roles/k3s_config — do not edit this file on the host; edit
# the node's committed profile under
# ci-runner/k3s/phase0-bare-metal/profiles/ and re-apply ansible/ci-pool.yml.
#
# THE HAZARD THIS FILE EXISTS FOR. A node whose profile declares NODE_DATA_DIR
# keeps k3s's whole per-node data directory — the bundled containerd's image and
# content store above all — on a volume that is not the root filesystem.
# `--data-dir` is in the agent's ExecStart from the install, so k3s uses that
# path from its very first start. If the volume is not mounted at that moment,
# k3s CREATES the directory on the root filesystem underneath the mountpoint and
# the mount then HIDES it: the store is there, the kubelet cannot see it, and
# nothing errors. That is the same shape as the 2026-09-07 incident in which a
# freshly formatted tier was laid over gmktec-xubuntu's running containerd store,
# which the kubelet spent ten minutes an hour reporting as missing.
#
# `RequiresMountsFor=` is systemd's own answer: it adds Requires= and After= on
# whichever mount unit covers this path, so the agent cannot start before the
# volume is there. Declarative, and it needs no knowledge here of WHICH device
# or fstab line provides it.
#
# The tier-carrying nodes get the equivalent from
# ci-runner/k3s/phase2/storage-layout/10-requires-storage-mounts.conf, installed
# by the storage_layout role — a node with no tier does not run that role, which
# is why this drop-in is rendered from the profile instead.
[Unit]
RequiresMountsFor={{ k3s_config_node_data_dir }}
