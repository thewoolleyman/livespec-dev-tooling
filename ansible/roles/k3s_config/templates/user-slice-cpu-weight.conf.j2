# RENDERED by ansible/roles/k3s_config — do not edit this file on the host;
# change k3s_config_user_slice_cpu_weight in the host's inventory host_vars
# and re-apply ansible/ci-pool.yml with --tags k3s_user_slice_cpu_weight.
#
# user.slice carries the local login sessions and competes at the cgroup ROOT
# against kubepods.slice, whose weight the kubelet derives from allocatable CPU,
# and against system.slice. A daemon-reload applies this weight to the running
# slice; nothing restarts. It is a share, never a pin: no CPU is kept idle for
# user.slice.
[Slice]
CPUWeight={{ k3s_config_user_slice_cpu_weight }}
