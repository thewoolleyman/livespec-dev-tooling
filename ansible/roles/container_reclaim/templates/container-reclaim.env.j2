# {{ ansible_managed }}
#
# Read by container-reclaim.sh with `set -a; source`. The shell installer
# copied hosts/<host>.env here verbatim, so this file carried that file's
# measurement essays as well as its values. The derivation record now lives
# where it is maintained -- the role's defaults/main.yml and HOST_VARS.md --
# and this file carries only what the reclaimer reads. Do not edit it here:
# a run of the container_reclaim role overwrites it.
RECLAIM_CANONICAL_HOST="{{ container_reclaim_canonical_host }}"
RECLAIM_SYSTEM_HOSTNAME="{{ container_reclaim_system_hostname }}"
RECLAIM_SERVICE_USER="{{ container_reclaim_service_user }}"
RECLAIM_SERVICE_GROUP="{{ container_reclaim_service_group }}"
RECLAIM_CONTAINER_IDLE_HOURS="{{ container_reclaim_container_idle_hours }}"
RECLAIM_IMAGE_IDLE_HOURS="{{ container_reclaim_image_idle_hours }}"
RECLAIM_ON_CALENDAR="{{ container_reclaim_on_calendar }}"
