#!/usr/bin/env bash
# with-factory-kubeconfig — run a command against the cluster with this host's
# `factory` credential, refreshing it ONCE if the API server rejects it.
#
#   with-factory-kubeconfig kubectl -n factory get pods
#
# THIS IS THE "PULL ON 401". The factory credential expires at every
# control-plane boot (see ./refresh-factory-kubeconfig for why), so the first
# call after a reboot is expected to be refused. Rather than have every caller
# learn that, this wrapper detects the rejection, re-fetches the kubeconfig, and
# retries the command exactly once.
#
# ONCE, deliberately. A retry loop would turn a genuinely revoked credential
# into an unbounded ssh hammer against the control-plane node. One refresh
# distinguishes the expected case (stale token from a reboot) from the real one
# (the credential is gone or the RBAC changed), and the second failure is
# reported as itself.
#
# FAILS CLOSED. If the refresh cannot fetch, the original failure stands and the
# exit status is non-zero. Nothing here ever decides that an unreachable cluster
# is a pass — that judgement belongs to the caller.
#
# THE REFRESH IS A ROOT WRITE AND THIS WRAPPER IS NOT ROOT. The credential this
# wrapper reads lives under /etc, owned by root and readable by the
# factory-client group; the Fabro service account is a MEMBER of that group,
# which is enough to read it and nothing like enough to replace it. So when this
# runs as a non-root user — which is every sandbox launch, since the Fabro
# server does not run as root — the refresh is invoked through non-interactive
# `sudo -n`. NON-INTERACTIVE on purpose: a sandbox launch has no terminal to
# prompt at, and a `sudo` that blocked for a password would hang the launch
# instead of failing it. A host whose service account lacks passwordless sudo
# for the refresh therefore fails the refresh loudly.
set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
REFRESH="${FACTORY_REFRESH_BIN:-${SCRIPT_DIR}/refresh-factory-kubeconfig}"
[ -x "${REFRESH}" ] || REFRESH=/usr/local/bin/refresh-factory-kubeconfig

export KUBECONFIG="${FACTORY_KUBECONFIG:-/etc/ci-runner/factory.kubeconfig}"

[ "$#" -gt 0 ] || { echo "usage: with-factory-kubeconfig <command> [args...]" >&2; exit 2; }

# Capture stderr so the rejection can be recognised, but pass BOTH streams
# through, so wrapping a command never swallows its output.
attempt_stderr="$(mktemp)"
attempt_stdin=""
trap 'rm -f "${attempt_stderr}" ${attempt_stdin:+"${attempt_stdin}"}' EXIT

# A RETRY NEEDS THE INPUT, NOT JUST THE ARGV, AND STDIN IS READABLE ONCE. The
# sandbox backend creates its pod as `kubectl create --filename -` with the
# manifest piped in, so the rejected first attempt DRAINS that pipe; re-running
# the same argv then reads EOF and dies with `error: no objects passed to
# create`. The credential would be refreshed and the pod would still not have
# been created — indistinguishable, to the caller, from the stale credential
# this wrapper exists to repair. So when the argv names stdin as an input, the
# bytes are captured to a file first and BOTH attempts read that file.
#
# ONLY when the argv names it, deliberately. Draining stdin unconditionally
# would block a command that never reads it — a `get` run from a terminal — and
# would swallow input the CALLER still needs.
stdin_fed=0
for arg in "$@"; do
  case "${arg}" in
    - | -f- | -f=- | --filename=-) stdin_fed=1; break ;;
  esac
done
if [ "${stdin_fed}" -eq 1 ]; then
  attempt_stdin="$(mktemp)"
  cat > "${attempt_stdin}"
fi

# One attempt at the wrapped command, reporting the WRAPPED command's status in
# `status` — both attempts go through here, so the retry cannot drift from the
# first attempt's plumbing.
#
# A PIPELINE RATHER THAN A PROCESS SUBSTITUTION, and the difference is a race
# the whole refresh rides on: bash does NOT wait for a `2> >(tee …)`
# substitution to finish, so the match below could read the capture file before
# `tee` had written a byte — and an EMPTY capture matches no pattern, however
# good the patterns are. The symptom is identical to a pattern that missed (a
# launch that failed with nothing refreshed) and it only appears under load, so
# an idle host says the wrapper works. In a pipeline bash waits for every
# member, so the capture is complete before it is read. The redirections keep
# the two streams separate — fd 3 carries the command's own stdout past `tee` to
# this wrapper's stdout, while only stderr goes down the pipe — and
# `PIPESTATUS[0]` is the WRAPPED command's status rather than `tee`'s.
attempt() {
  if [ -n "${attempt_stdin}" ]; then
    { { "$@" < "${attempt_stdin}" 2>&1 1>&3 3>&-; } | tee "${attempt_stderr}" >&2; } 3>&1
  else
    { { "$@" 2>&1 1>&3 3>&-; } | tee "${attempt_stderr}" >&2; } 3>&1
  fi
  status="${PIPESTATUS[0]}"
}

attempt "$@"
[ "${status}" -eq 0 ] && exit 0

# The API server's rejection wording, as `kubectl` renders it. Matching on the
# message rather than on the status alone is deliberate: a non-zero exit can
# mean many things, and refreshing a credential is only the right response to a
# credential being refused.
#
# ONE REFUSAL, SEVERAL RENDERINGS, SO THE LAST PATTERN IS THE MESSAGE AND NOT A
# FRAMING OF IT. The first three patterns are kubectl's `(Unauthorized)`
# framing; `provide credentials` is the tail of the message the API SERVER
# itself attaches to an unauthenticated response, which carries none of those
# three words and which kubectl re-dresses per verb. A read gets it as
# `error: <message>`, but `apply` and `create` validate before they send, so
# they get it as a failed OpenAPI download inside a validation error about
# `"STDIN"` — and matching any one framing leaves the others unrecognised.
# Measured 2026-10-12 on the sibling gates path: the first delegated push after
# a control-plane reboot met the validation framing, no refresh ran, and the
# push was refused with no verdict while the stale credential stayed on disk.
# Anchoring the match to the server's own words keeps it narrow — a manifest
# that is genuinely malformed says so in other words.
if grep -qiE 'Unauthorized|error: You must be logged in|401|provide credentials' "${attempt_stderr}"; then
  echo "with-factory-kubeconfig: credential rejected — refreshing once and retrying" >&2
  # The refresh writes under /etc; this wrapper is the Fabro service account.
  # `sudo -n` is how the write happens without a prompt a sandbox launch could
  # not answer.
  if [ "$(id -u)" -eq 0 ]; then
    refresh_argv=("${REFRESH}")
  else
    refresh_argv=(sudo -n "${REFRESH}")
  fi
  if ! "${refresh_argv[@]}"; then
    echo "with-factory-kubeconfig: refresh FAILED; original failure stands" >&2
    exit "${status}"
  fi
  attempt "$@"
  exit "${status}"
fi

exit "${status}"
