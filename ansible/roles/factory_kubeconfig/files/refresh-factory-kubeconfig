#!/usr/bin/env bash
# refresh-factory-kubeconfig — re-fetch this host's `factory` namespace
# kubeconfig from the cluster's control-plane node.
#
# WHY THIS EXISTS AT ALL, rather than a one-time copy. The control-plane node's
# k3s datastore is a tmpfs and is EMPTY at every boot, so the `factory`
# namespace's `sandbox-launcher` ServiceAccount and its token Secret are
# RECREATED on each boot and a kubeconfig copied once carries a token the fresh
# API server has never seen. Every call then fails `Unauthorized`. That exact
# failure was measured on 2026-09-02 for the otel-collector identity
# (Unauthorized, 300+ restarts) and is why the node's converge re-renders this
# file on every boot. This script is the other half: the Fabro-server host
# re-fetches it.
#
# WHY A PULL RATHER THAN A PUSH. A push from the control-plane node would need
# it to hold an ssh credential toward every factory host and to know each
# address. A pull needs nothing new — a factory host already reaches the node
# over the tailnet with key-based ssh — it retries naturally, and it fails
# closed: if it cannot fetch, it writes nothing and leaves the existing file
# alone.
#
# THE TOKEN NEVER TOUCHES A TERMINAL AND NEVER REACHES AN ARGV. It is piped
# from the remote `cat` into a shell variable and out again over STDIN, never as
# a command-line argument. Nothing here echoes the value, and the script's own
# output names only paths and outcomes. The one file it does touch is the
# owner-only temp file the write below renames over the destination; see that
# step for why a rename replaced the `install -m 0600 /dev/stdin` idiom.
#
# Idempotent: re-running is the supported repair path. Safe to run when the
# current file is already valid — it simply rewrites identical bytes.
set -euo pipefail

# THE POOL FACTS COME FROM THE ENV-FILE, AND NO MACHINE IS NAMED IN THIS
# SCRIPT. Which node renders the credential, which local account's tailnet
# identity can fetch it, and which group the replacement must carry are all
# facts of the pool this host belongs to, written by the factory_kubeconfig
# Ansible role. A hostname defaulted here would be a second, silent place a
# machine binding lives (livespec-dev-tooling-prdxxe) — and a WRONG one the
# moment the pool's server moves, with the failure arriving as an unexplained
# ssh timeout on a host nobody is watching. So there is no default to be wrong:
# an un-provisioned host refuses loudly below.
FACTORY_REFRESH_ENV="${FACTORY_REFRESH_ENV:-/etc/ci-runner/factory-refresh.env}"
# shellcheck source=/dev/null
[ -r "${FACTORY_REFRESH_ENV}" ] && . "${FACTORY_REFRESH_ENV}"

REMOTE_HOST="${FACTORY_REMOTE_HOST:-}"
REMOTE_PATH="${FACTORY_REMOTE_KUBECONFIG:-/etc/ci-runner/factory.kubeconfig}"
DEST="${FACTORY_KUBECONFIG:-/etc/ci-runner/factory.kubeconfig}"

# THE REPLACEMENT CARRIES THE SAME OWNER, GROUP AND MODE THE ROLE INSTALLS:
# root:<factory-client group> 0640. The Fabro server runs as the host's service
# account, which is a MEMBER of that group — group-readable is the whole reason
# the sandbox backend can read the credential at all — so a refresh that left
# the file root-only would silently un-provision the host it just refreshed,
# with the next launch failing on a file that is perfectly valid.
FACTORY_SSH_USER="${FACTORY_SSH_USER:-}"
FACTORY_GROUP="${FACTORY_GROUP:-}"
FACTORY_MODE=0640

log() { printf '%s refresh-factory-kubeconfig: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

for fact in REMOTE_HOST FACTORY_SSH_USER FACTORY_GROUP; do
  if [ -z "${!fact}" ]; then
    log "NO ${fact} — ${FACTORY_REFRESH_ENV} is missing or incomplete; leaving ${DEST} unchanged"
    log "fix: converge this host with \`just ansible-apply ansible/fabro-hosts.yml --tags factory_kubeconfig\`, which writes that file from the inventory"
    exit 1
  fi
done

# The fetch, routed through FACTORY_SSH_USER's identity when we hold root and
# that user is not root. The ssh key that reaches the control-plane node over
# the tailnet belongs to a login user, NOT to root: root on a factory host has
# no tailnet ssh identity, so an `ssh <node>` issued as root fails to
# authenticate (measured live 2026-09-10 on the sibling gates path). But the
# sandbox backend may invoke this as root, and the destination under /etc needs
# root. So when this runs as root we drop ONLY the fetch to FACTORY_SSH_USER
# via `sudo -u`, then write as root; run interactively by that user, the fetch
# is a plain ssh. `sudo -u <user> -H` gives ssh that user's HOME so it finds
# their ~/.ssh key and config. The token is still produced only on this
# function's stdout and captured into a variable — it never reaches a terminal
# or a temp file.
ssh_fetch() {
  if [ "$(id -u)" -eq 0 ] && [ "${FACTORY_SSH_USER}" != root ]; then
    sudo -u "${FACTORY_SSH_USER}" -H ssh -o BatchMode=yes -o ConnectTimeout=15 \
      "${REMOTE_HOST}" "sudo cat ${REMOTE_PATH}"
  else
    ssh -o BatchMode=yes -o ConnectTimeout=15 "${REMOTE_HOST}" "sudo cat ${REMOTE_PATH}"
  fi
}

# Fetch into memory, not into a file of its own: a loose temp file holding a
# bearer token for the length of a fetch is a window this design does not need
# to open. The only file the token ever reaches is the destination's own 0600
# stand-in, created and renamed within the write step below.
if ! rendered="$(ssh_fetch 2>/dev/null)"; then
  log "FAILED to fetch ${REMOTE_HOST}:${REMOTE_PATH} — leaving ${DEST} unchanged"
  log "check: ${REMOTE_HOST} reachable over the tailnet as ${FACTORY_SSH_USER} (root drops to that identity via sudo -u), sudo available there, and converge has rendered the file"
  exit 1
fi

# A truthful-looking but empty or malformed answer is worse than a failure,
# because it would overwrite a good file with a useless one. Require the two
# markers a rendered kubeconfig must carry before writing anything.
if ! printf '%s' "${rendered}" | grep -q '^kind: Config$' \
  || ! printf '%s' "${rendered}" | grep -q 'server:'; then
  log "FETCHED CONTENT IS NOT A KUBECONFIG — refusing to overwrite ${DEST}"
  exit 1
fi

install -d -m 0755 "$(dirname "${DEST}")"

# THE WRITE IS A TEMP FILE AND A RENAME, NOT `install /dev/stdin "${DEST}"`.
# uutils coreutils — what Ubuntu 25.10 and 26.04 ship INSTEAD of GNU
# coreutils, and what the factory hosts and the control-plane node all run —
# fails `install` with `install: No such file or directory` (exit 1) whenever
# the DESTINATION operand already exists. That makes a credential that cannot
# self-heal: the pull-on-rejection path calls this script precisely when the
# file is already there and stale. Measured 2026-10-11 on uutils 0.2.2 (Ubuntu
# 25.10) and 0.8.0 (Ubuntu 26.04): absent destination exit 0, existing
# destination exit 1 (livespec-dev-tooling-74q6iw).
#
# A temp file in the DESTINATION's own directory, created under `umask 077` so
# it is never readable beyond its owner for even an instant, given the
# destination's mode, and then renamed over the destination, is atomic, keeps
# the token off every argv, and behaves identically under GNU coreutils and
# uutils. A `gnu`-prefixed binary is NOT the fix: it is not guaranteed present
# on every host in the fleet.
tmp_dest="$(umask 077 && mktemp "${DEST}.refresh.XXXXXX")"
trap 'rm -f -- "${tmp_dest}"' EXIT
printf '%s\n' "${rendered}" | tee "${tmp_dest}" > /dev/null
unset rendered

# OWNERSHIP BEFORE MODE, AND BEFORE THE RENAME. The temp file is created under
# `umask 077`, so it is owner-only for its whole life; widening it to the
# factory-client group is the LAST thing done to it, and the rename then
# publishes a file that was never group-readable while it was still being
# written.
#
# Only root can give the file away, and only root ever needs to: the write runs
# as root both from the backend and under the `sudo -n` the wrapper uses. Run
# interactively by a user who owns the destination, the chown is skipped and
# the mode still lands — a refusal there would be a self-inflicted failure on a
# path that is already writing a file that user owns.
if [ "$(id -u)" -eq 0 ]; then
  if ! chown "root:${FACTORY_GROUP}" "${tmp_dest}"; then
    log "FAILED to set root:${FACTORY_GROUP} on the replacement — is the ${FACTORY_GROUP} group provisioned on this host? leaving ${DEST} unchanged"
    exit 1
  fi
fi
chmod "${FACTORY_MODE}" "${tmp_dest}"
mv -f "${tmp_dest}" "${DEST}"
trap - EXIT
log "refreshed ${DEST} from ${REMOTE_HOST}:${REMOTE_PATH} (root:${FACTORY_GROUP}, mode ${FACTORY_MODE})"
