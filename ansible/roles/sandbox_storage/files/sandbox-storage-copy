#!/usr/bin/python3
# Managed by Ansible (role: sandbox_storage). Local edits are overwritten.
#
# The ONE writer of a store onto the sandbox storage disk. Every copy — the
# live preseed and the cutover's checksummed copy — goes through this script,
# which holds the host-side lock for the WHOLE of: reading the record, the
# copy, and (cutover only) publishing `copied: true`. A copy and its
# publication are therefore one critical section, and no other copy can start
# between them (Codex review 5, finding 1).
#
# The record is read FAIL-CLOSED. Three outcomes, and only one permits a copy:
#   absent file, or entry absent / copied false  -> copy
#   entry copied true                            -> exit 75, copy nothing
#   unreadable, malformed, or copied not a bool  -> exit 76, copy nothing
#
# Exit codes: 0 copied; 24 (preseed only) rsync saw vanished files, routine on
# a live store; 73 the lock is held by another copy; 75 already copied; 76 the
# record cannot be trusted; anything else is rsync's own failure.
#
# usage: sandbox-storage-copy {preseed|cutover} LOCK RECORD ROLE SOURCE DEST [BWLIMIT]

import fcntl
import json
import os
import subprocess
import sys
import time

EX_LOCKED = 73
EX_COPIED = 75
EX_UNTRUSTED = 76


def read_entry(record, role):
    """Return (copied, data); raise ValueError on anything untrustworthy."""
    if not os.path.exists(record):
        return False, {}
    with open(record, encoding="utf-8") as fh:
        data = json.load(fh)
    if not isinstance(data, dict):
        raise ValueError("record is not a JSON object")
    entry = data.get(role)
    if entry is None:
        return False, data
    if not isinstance(entry, dict) or not isinstance(entry.get("copied"), bool):
        raise ValueError(f"entry {role!r} is malformed: {entry!r}")
    return entry["copied"], data


def publish_copied(record, role, data):
    """Mark ROLE copied, atomically: temp file, fsync, rename, fsync dir."""
    entry = data.get(role)
    if not isinstance(entry, dict):
        raise ValueError(f"cutover without a record entry for {role!r}")
    entry["copied"] = True
    tmp = record + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=4, sort_keys=True)
        fh.write("\n")
        fh.flush()
        os.fsync(fh.fileno())
    os.chmod(tmp, 0o600)
    os.replace(tmp, record)
    dfd = os.open(os.path.dirname(record) or ".", os.O_RDONLY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)

PARALLEL = 8


def cutover_copy(source, dest):
    """Mirror SOURCE onto DEST: parallel per-subtree rsyncs, then one full pass.

    No -c. Measured on hp 2026-10-12: a single-threaded checksum pass over a
    containerd store of small files ran at ~1,100 reads/s (~10 MB/s) on the
    DRAM-less destination, putting the window at hours. Size+mtime is the
    comparison instead; the in-place-mutation case -c guarded against is
    confined to the writable layers of containers ended by this very cutover
    (blobs and image layers are immutable and content-addressed, and the bolt
    metadata DB changes size and mtime when written). Maintainer decision,
    2026-10-12.

    Phase 1 runs up to PARALLEL rsyncs over the depth-2 subdirectories, where
    nearly all of a store's bytes live (snapshots/<n>, overlay2/<id>, ...).
    Phase 2 is one rsync over the whole store: by then every subtree is in
    place, so it is mostly a stat scan, and it carries what phase 1 did not —
    files at depth 1 and 2, deletions above the units, and hardlinks that
    cross unit boundaries (-H links only within one rsync process).
    """
    units = []
    for top in sorted(os.listdir(source)):
        top_path = os.path.join(source, top)
        if os.path.isdir(top_path) and not os.path.islink(top_path):
            for sub in sorted(os.listdir(top_path)):
                sub_path = os.path.join(top_path, sub)
                if os.path.isdir(sub_path) and not os.path.islink(sub_path):
                    units.append(os.path.join(top, sub))
    print(f"phase 1: {len(units)} subtrees, {PARALLEL} at a time", flush=True)
    running = []
    failed = []
    for unit in units:
        os.makedirs(os.path.dirname(os.path.join(dest, unit)), exist_ok=True)
        while len(running) >= PARALLEL:
            running = reap(running, failed)
        running.append((unit, subprocess.Popen(
            ["rsync", "-aHAX", "--delete",
             os.path.join(source, unit) + "/", os.path.join(dest, unit) + "/"])))
    while running:
        running = reap(running, failed)
    if failed:
        print(f"phase 1 failed for: {failed}", file=sys.stderr)
        return 1
    print("phase 2: full pass", flush=True)
    return subprocess.call(["rsync", "-aHAX", "--delete", source + "/", dest + "/"])


def reap(running, failed):
    """Wait for one of RUNNING to finish; return the rest."""
    while True:
        for i, (unit, proc) in enumerate(running):
            rc = proc.poll()
            if rc is not None:
                if rc != 0:
                    failed.append((unit, rc))
                return running[:i] + running[i + 1:]
        time.sleep(0.2)


def main(argv):
    if len(argv) not in (7, 8) or argv[1] not in ("preseed", "cutover"):
        print(__doc__ or "bad usage", file=sys.stderr)
        return 64
    mode, lock, record, role, source, dest = argv[1:7]
    bwlimit = argv[7] if len(argv) == 8 else ""

    lock_fd = os.open(lock, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print(f"{lock} is held by another copy", file=sys.stderr)
        return EX_LOCKED

    # From here to exit the lock is held: the record read, the copy and the
    # publication cannot interleave with any other copy.
    try:
        copied, data = read_entry(record, role)
    except (OSError, ValueError) as exc:
        print(f"refusing to copy {role}: record {record} cannot be trusted: {exc}", file=sys.stderr)
        return EX_UNTRUSTED
    if copied:
        print(f"{role} is already recorded as copied; nothing to do")
        return EX_COPIED

    if mode == "preseed":
        cmd = ["ionice", "-c3", "nice", "-n19", "rsync", "-aHAX"]
        if bwlimit:
            cmd.append(f"--bwlimit={bwlimit}")
        cmd += [source.rstrip("/") + "/", dest.rstrip("/") + "/"]
        rc = subprocess.call(cmd)
        return rc if rc in (0, 24) else rc

    rc = cutover_copy(source.rstrip("/"), dest.rstrip("/"))
    if rc != 0:
        return rc
    # Re-read under the same lock before publishing: the entry must still be
    # the uncopied one this run wrote.
    try:
        copied, data = read_entry(record, role)
        if copied:
            raise ValueError(f"{role} became copied during this copy")
        publish_copied(record, role, data)
    except (OSError, ValueError) as exc:
        print(f"copy of {role} completed but could not be published: {exc}", file=sys.stderr)
        return EX_UNTRUSTED
    print(f"{role} copied and published")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
