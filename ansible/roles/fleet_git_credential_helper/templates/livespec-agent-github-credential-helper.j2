#!/bin/sh
# {{ ansible_managed }}
# Managed by livespec-dev-tooling role fleet_git_credential_helper.
#
# The git credential helper that this host's fleet clones name in .git/config
# (credential.https://github.com.helper = !{{ fleet_git_credential_helper_dest }}).
# It mints a GitHub App installation token for git through the livespec-runtime
# helper. It was installed by hand on 2026-07-02 (livespec-orslcm Pillar 3) and
# is now owned by this role.
#
# Two routes:
#   - A clone whose committed .livespec.jsonc maps GITHUB_APP_ID_ORG onto the
#     runtime's GITHUB_APP_ID (route C, after the livespec-ai organization
#     transfer) mints through its own credential_wrapper, by way of the tenant
#     wrapper. The bare family wrapper projects the personal App, which
#     livespec-ai repositories refuse with a 403.
#   - Every other clone (homelab, hetzner-xubuntu-info and the rest) keeps the
#     original path, the family wrapper.
# Once role reconcile_runs (livespec-dev-tooling#4796) installs the resolved-path
# tenant wrapper at {{ fleet_git_credential_helper_tenant_wrap }} on this host,
# the GITHUB_APP_ID_ORG grep can be dropped and every clone can take the tenant
# wrapper: it resolves the clone's committed credential_wrapper and falls back
# to the family wrapper itself.
helper={{ fleet_git_credential_helper_runtime_helper }}
top=$(git rev-parse --show-toplevel 2>/dev/null) || top=
if [ -n "$top" ] && [ -x {{ fleet_git_credential_helper_tenant_wrap }} ] \
   && grep -q 'GITHUB_APP_ID_ORG' "$top/.livespec.jsonc" 2>/dev/null; then
  TW_REPO="$top" exec {{ fleet_git_credential_helper_tenant_wrap }} -- "$helper" "$@"
fi
exec {{ fleet_git_credential_helper_family_wrapper }} -- "$helper" "$@"
