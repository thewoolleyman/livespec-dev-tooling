# {{ ansible_managed }}
[Unit]
Description=File root-fix work items from flake-retry records
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ flake_retry_filer_user }}
Group={{ flake_retry_filer_group }}
WorkingDirectory={{ flake_retry_filer_repo_root }}
ExecStart=/usr/local/bin/with-livespec-env.sh -- {{ flake_retry_filer_python }} -m livespec_dev_tooling.flake_retry_filer --repo-root {{ flake_retry_filer_repo_root }} --state-dir {{ flake_retry_filer_state_dir }}
TimeoutStartSec={{ flake_retry_filer_interval }}
