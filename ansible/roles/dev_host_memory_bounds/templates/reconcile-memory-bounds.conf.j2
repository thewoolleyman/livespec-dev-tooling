# {{ ansible_managed }} — role dev_host_memory_bounds.
# Host bound on the orchestrator's reconcile-runs timer unit. The unit itself
# belongs to livespec-orchestrator-beads-fabro's install.sh; this drop-in only
# bounds it. Takes effect at the next timer pass.
[Service]
MemoryAccounting=yes
MemoryHigh={{ dev_host_memory_bounds_reconcile_memory_high }}
MemoryMax={{ dev_host_memory_bounds_reconcile_memory_max }}
OOMScoreAdjust={{ dev_host_memory_bounds_reconcile_oom_score_adjust }}
