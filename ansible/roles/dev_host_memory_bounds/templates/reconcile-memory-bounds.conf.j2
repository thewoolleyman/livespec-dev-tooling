# {{ ansible_managed }} — role dev_host_memory_bounds.
# The OOM-killer preference for the orchestrator's reconcile-runs timer unit.
# The unit itself, with its memory and CPU numbers, belongs to
# livespec-orchestrator-beads-fabro's install.sh; this drop-in adds only what
# that unit does not set. Takes effect at the next timer pass.
[Service]
OOMScoreAdjust={{ dev_host_memory_bounds_reconcile_oom_score_adjust }}
