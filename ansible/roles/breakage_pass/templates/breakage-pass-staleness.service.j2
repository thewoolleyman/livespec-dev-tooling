# {{ ansible_managed }}
# Reports repositories whose breakage pass has not succeeded within
# {{ breakage_pass_stale_after_seconds }}s (role breakage_pass). It runs role
# reconcile_runs's staleness check, whose journal line reads
# `reconcile-runs-stale tenant=<name> age_seconds=<n>`; here <name> is a watched
# repository, not a reconcile-runs tenant.
[Unit]
Description=Report breakage pass repositories with no successful pass within {{ breakage_pass_stale_after_seconds }}s
{% if breakage_pass_staleness_on_failure %}
OnFailure={{ breakage_pass_staleness_on_failure }}
{% endif %}

[Service]
Type=oneshot
User={{ breakage_pass_user }}
Group={{ breakage_pass_group }}
ExecStart={{ breakage_pass_staleness_bin }}{% if breakage_pass_staleness_on_failure %} --alert-state {{ breakage_pass_staleness_alert_state }} --realert-seconds {{ breakage_pass_staleness_realert_seconds }}{% endif %} {{ breakage_pass_stale_after_seconds }}{% for r in breakage_pass_repos %} {{ r.name }}={{ breakage_pass_state_dir }}/{{ r.name }}.last-success{% endfor %}

