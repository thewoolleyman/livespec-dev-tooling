#!/usr/bin/env bash
# Run one breakage pass and journal its outcome (role breakage_pass).
#
# usage: livespec-breakage-pass <name> <repo> <plugin_root> <python> <state_dir> <checkout> <branch>
#
# The pass reads two checkouts on this host: the orchestrator's own (<checkout>,
# the dispatcher it runs) and the watched repository's (<repo>, the committed
# .livespec.jsonc it reads). Nothing else advances either of them, so a merged fix
# is not a running fix: COMMITTED IS NOT CONVERGED. Before each pass this script
# fetches origin/<branch> in each and fast-forwards it, FAILING CLOSED. It refuses
# (exit 70, no success marker) when the checkout is not a git checkout, is on a
# branch other than <branch> (a detached HEAD is the usual state), has modified
# tracked files, cannot fetch, holds commits origin/<branch> lacks, or cannot
# fast-forward. A pass never runs on a stale or foreign reader.
#
# One line per synced checkout:
#   breakage-pass-sync repo=<name> path=<path> head=<sha> origin=<sha> action=<current|advanced>
# or, on a refusal:
#   breakage-pass-sync-refused repo=<name> path=<path> reason=<reason>
#
# `dispatcher.py breakage-pass` prints one verdict line per watched workflow, and
# nothing at all when the repository watches none. This script adds one line per
# pass either way, so the journal shows that the pass ran and how it ended:
#
#   breakage-pass-result repo=<name> rc=<n>
#
# A pass that exits 0 refreshes <state_dir>/<name>.last-success. The pass's own
# exit status is this script's exit status, except a refused sync, which is 70.
#
# A LIVE DISPATCHER HOLDS THE PASS BACK. The orchestrator checkout is also the
# dispatcher's launcher tree. A launcher past launch, or a sourced lib (config.sh,
# launch-lib.sh), may not survive an in-place edit because bash reads a script
# incrementally, so a fast-forward under a running launcher is not safe. While any
# dispatch-dual.sh or resume-capped.sh process has that tree as its cwd or script
# path, this script skips the WHOLE pass: no fetch, no fast-forward, no pass. It
# does not run read-only on the current HEAD either, because that HEAD may predate a
# fix the pass depends on (a reader without #5513's manual admission would file
# auto-admission items). It journals
#   breakage-pass-skipped repo=<name> reason=dispatcher-live pid=<pid> script=<basename> detail=<why>
# exits 0, writes NO success marker and does not trip OnFailure=. A skip is
# therefore visible in the journal, and a skip that lasts past the staleness bound
# (breakage_pass_stale_after_seconds) is reported by the staleness unit, because the
# marker stops advancing.
#
# Detection reads <proc_root>/<pid>/cmdline and <proc_root>/<pid>/cwd for every
# process. It never uses pgrep -f, whose own argv would name the pattern it looks
# for. A process matches when one of its first four argv words is named
# dispatch-dual.sh or resume-capped.sh AND that script path, or the process cwd, lies
# under the tree. A word naming a script under another tree with a readable cwd
# outside this one does not match. A process whose cwd cannot be read and whose
# script path does not name the tree is treated as live: the script cannot rule the
# tree out, so it fails closed. A process that vanishes mid-scan, or whose cmdline
# cannot be read at all, names nothing and does not match. LIVESPEC_BREAKAGE_PROC_ROOT
# (default /proc) exists only so tests can supply a fake process table.
set -u
name=$1
repo=$2
plugin_root=$3
python=$4
state_dir=$5
checkout=$6
branch=$7

export GIT_TERMINAL_PROMPT=0
proc_root=${LIVESPEC_BREAKAGE_PROC_ROOT:-/proc}

# live_dispatcher <tree>: print "<pid> <script> <detail>" for the first dispatcher
# process on <tree> and return 0, or return 1 when none is live.
live_dispatcher() {
    local tree entry pid argv word base script cwd detail
    tree=$(readlink -f "$1" 2>/dev/null) || tree=$1
    for entry in "$proc_root"/[0-9]*; do
        pid=${entry##*/}
        [ "$pid" = "$$" ] && continue
        mapfile -d '' -t argv < "$entry/cmdline" 2>/dev/null || continue
        for word in "${argv[@]:0:4}"; do
            base=${word##*/}
            case "$base" in
                dispatch-dual.sh | resume-capped.sh) ;;
                *) continue ;;
            esac
            cwd=$(readlink "$entry/cwd" 2>/dev/null) || cwd=
            if [ -z "$cwd" ] && [ ! -e "$entry" ]; then
                break
            fi
            script=$word
            case "$script" in
                /*) ;;
                *) script=${cwd:-.}/$script ;;
            esac
            script=$(realpath -m "$script" 2>/dev/null) || script=$word
            detail=
            case "$script" in
                "$tree"/*) detail=script-path ;;
            esac
            if [ -z "$detail" ] && [ -n "$cwd" ]; then
                case "$cwd" in
                    "$tree" | "$tree"/*) detail=cwd ;;
                esac
            fi
            if [ -z "$detail" ] && [ -z "$cwd" ]; then
                detail=cwd-unreadable
            fi
            if [ -n "$detail" ]; then
                printf '%s %s %s\n' "$pid" "$base" "$detail"
                return 0
            fi
            break
        done
    done
    return 1
}

if live=$(live_dispatcher "$checkout"); then
    read -r live_pid live_script live_detail <<<"$live"
    printf 'breakage-pass-skipped repo=%s reason=dispatcher-live pid=%s script=%s detail=%s\n' \
        "$name" "$live_pid" "$live_script" "$live_detail"
    exit 0
fi

# sync_checkout <path>: fast-forward <path> to origin/<branch>, or refuse.
# Prints the journal line; returns non-zero on a refusal.
sync_checkout() {
    path=$1
    refuse() {
        printf 'breakage-pass-sync-refused repo=%s path=%s reason=%s\n' "$name" "$path" "$1"
        return 1
    }
    git -C "$path" rev-parse --git-dir >/dev/null 2>&1 || { refuse not-a-git-checkout; return 1; }
    current=$(git -C "$path" symbolic-ref -q --short HEAD || true)
    if [ -n "$current" ] && [ "$current" != "$branch" ]; then
        refuse "on-branch-$current"
        return 1
    fi
    if [ -n "$(git -C "$path" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
        refuse modified-tracked-files
        return 1
    fi
    if ! git -C "$path" fetch --quiet origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>/dev/null; then
        refuse fetch-failed
        return 1
    fi
    head=$(git -C "$path" rev-parse HEAD) || { refuse no-head; return 1; }
    target=$(git -C "$path" rev-parse "refs/remotes/origin/$branch") || { refuse no-origin-ref; return 1; }
    action=current
    if [ "$head" != "$target" ]; then
        if ! git -C "$path" merge-base --is-ancestor "$head" "$target"; then
            refuse not-fast-forward
            return 1
        fi
        if ! git -C "$path" merge --ff-only --quiet "refs/remotes/origin/$branch" >/dev/null 2>&1; then
            refuse ff-failed
            return 1
        fi
        head=$(git -C "$path" rev-parse HEAD)
        if [ "$head" != "$target" ]; then
            refuse ff-did-not-reach-origin
            return 1
        fi
        action=advanced
    fi
    printf 'breakage-pass-sync repo=%s path=%s head=%s origin=%s action=%s\n' \
        "$name" "$path" "$head" "$target" "$action"
}

synced=0
sync_checkout "$checkout" || synced=1
if [ "$repo" != "$checkout" ] && [ "$synced" -eq 0 ]; then
    sync_checkout "$repo" || synced=1
fi
if [ "$synced" -ne 0 ]; then
    printf 'breakage-pass-result repo=%s rc=70\n' "$name"
    exit 70
fi

"$python" "$plugin_root/scripts/bin/dispatcher.py" breakage-pass --repo "$repo"
rc=$?
printf 'breakage-pass-result repo=%s rc=%d\n' "$name" "$rc"
if [ "$rc" -eq 0 ]; then
    touch "$state_dir/$name.last-success"
fi
exit "$rc"
