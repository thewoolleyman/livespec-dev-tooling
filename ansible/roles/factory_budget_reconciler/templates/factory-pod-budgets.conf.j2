# Managed by the livespec-dev-tooling factory_budget_reconciler role. Do not edit by hand.
# One `<node> <factory_pod_budget>` per ci_pool host that declares a budget, read
# from ansible/inventory/host_vars/<node>.yml (the one source of truth). A factory
# node with no line gets budget 0. TEMPORARY fixed factory-vs-CI CPU share.
{% for host in groups[factory_budget_reconciler_group] | sort %}
{% if hostvars[host].factory_pod_budget is defined %}
{{ host }} {{ hostvars[host].factory_pod_budget | int }}
{% endif %}
{% endfor %}
# Every container worker (homelab-worker.livespec.dev/class=worker) with no line of
# its own: the class-wide budget. A worker has no host_vars file, so enrolling it
# needs no change here (plan homelab-k8s-worker-nodes, livespec-dev-tooling-ko26ez.7).
@container-worker {{ factory_budget_reconciler_container_worker_pod_budget | int }}
