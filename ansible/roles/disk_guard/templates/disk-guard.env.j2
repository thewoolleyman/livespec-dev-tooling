# Rendered by the Ansible role disk_guard. Do not edit on the host: the next
# apply overwrites it, and a hand-edited threshold is exactly the untracked
# state this file exists to end.
#
# install.sh copied hosts/<host>.env here verbatim, so the installed file also
# carried DISK_GUARD_CANONICAL_HOST and DISK_GUARD_SYSTEM_HOSTNAME. Neither
# reaches the host now: both existed only for the installer's hostname guard,
# which inventory targeting replaces, and disk-guard.sh reads nothing but the
# threshold.
DISK_GUARD_THRESHOLD_GB={{ disk_guard_threshold_gb }}
