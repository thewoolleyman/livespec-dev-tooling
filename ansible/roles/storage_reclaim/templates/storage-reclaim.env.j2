# {{ ansible_managed }}
#
# Read by storage-reclaim.sh with `set -a; source`. The shell installer copied
# hosts/<host>.env here verbatim, so this file carried that file's measurement
# essays as well as its values. The derivation record now lives where it is
# maintained -- the role's defaults/main.yml and HOST_VARS.md -- and this file
# carries only what the reclaimer reads. Do not edit it here: a run of the
# storage_reclaim role overwrites it.
RECLAIM_CANONICAL_HOST="{{ storage_reclaim_canonical_host }}"
RECLAIM_SYSTEM_HOSTNAME="{{ storage_reclaim_system_hostname }}"
RECLAIM_SERVICE_USER="{{ storage_reclaim_service_user }}"
RECLAIM_SERVICE_GROUP="{{ storage_reclaim_service_group }}"
RECLAIM_HOME="{{ storage_reclaim_home }}"
RECLAIM_WORKTREE_ROOT="{{ storage_reclaim_worktree_root }}"
# Space-separated.
RECLAIM_CHECKOUT_ROOTS="{{ storage_reclaim_checkout_roots }}"
RECLAIM_ARTIFACT_IDLE_DAYS="{{ storage_reclaim_artifact_idle_days }}"
RECLAIM_ORPHAN_IDLE_DAYS="{{ storage_reclaim_orphan_idle_days }}"
RECLAIM_ON_CALENDAR="{{ storage_reclaim_on_calendar }}"
