#!/usr/bin/env bash
# with-gates-kubeconfig — run a command against the cluster with this host's
# gates credential, refreshing it ONCE if the API server rejects it.
#
#   with-gates-kubeconfig kubectl -n gates get jobs
#
# THIS IS THE "PULL ON 401" of R4.S8. The gates credential expires at every
# poweredge boot (see ./refresh-gates-kubeconfig for why), so the first call
# after a reboot is expected to fail 401. Rather than have every caller learn
# that, this wrapper detects the rejection, re-fetches the kubeconfig, and
# retries the command exactly once.
#
# ONCE, deliberately. A retry loop would turn a genuinely revoked credential
# into an unbounded ssh hammer against poweredge. One refresh distinguishes the
# expected case (stale token from a reboot) from the real one (the credential is
# gone or the RBAC changed), and the second failure is reported as itself.
#
# FAILS CLOSED. If the refresh cannot fetch, the original failure stands and the
# exit status is non-zero. Nothing here ever decides that an unreachable cluster
# is a pass — that judgement belongs to the caller, and for the delegated gate
# the answer is an ABSENT verdict, never a green one.
#
# THE REFRESH IS A ROOT WRITE AND THIS WRAPPER IS NOT ROOT. The credential this
# wrapper reads lives under /etc, owned by root and readable by the gate-client
# group; the pushing user is a MEMBER of that group, which is enough to read it
# and nothing like enough to replace it. So when this runs as a non-root user —
# which is every delegated push, since the gate client runs as the pushing user —
# the refresh is invoked through non-interactive `sudo -n`. NON-INTERACTIVE on
# purpose: a pre-push hook has no terminal to prompt at, and a `sudo` that
# blocked for a password would hang the push instead of failing it. A host whose
# login user lacks passwordless sudo for the refresh therefore fails the refresh
# loudly, which the caller reads as a gate that reached no verdict.
set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
REFRESH="${GATES_REFRESH_BIN:-${SCRIPT_DIR}/refresh-gates-kubeconfig}"
[ -x "${REFRESH}" ] || REFRESH=/usr/local/bin/refresh-gates-kubeconfig

export KUBECONFIG="${GATES_KUBECONFIG:-/etc/ci-runner/gates.kubeconfig}"

[ "$#" -gt 0 ] || { echo "usage: with-gates-kubeconfig <command> [args...]" >&2; exit 2; }

# Capture stderr so the 401 can be recognised, but pass BOTH streams through, so
# wrapping a command never swallows its output.
attempt_stderr="$(mktemp)"
trap 'rm -f "${attempt_stderr}"' EXIT

"$@" 2> >(tee "${attempt_stderr}" >&2)
status=$?
[ "${status}" -eq 0 ] && exit 0

# The API server's rejection wording, as `kubectl` renders it. Matching on the
# message rather than on the status alone is deliberate: a non-zero exit can mean
# many things, and refreshing a credential is only the right response to a
# credential being refused.
#
# ONE REFUSAL, SEVERAL RENDERINGS. The first three patterns are kubectl's
# `(Unauthorized)` framing; the fourth is the message the API SERVER itself
# attaches to an unauthenticated response, which carries none of those three
# words. A wrapper that knew only the framing repaired the host only by luck —
# measured 2026-10-12, when the first delegated push after a control-plane reboot
# met the server's own wording, no refresh ran, and the push was refused with no
# verdict while the stale credential stayed on disk.
if grep -qiE 'Unauthorized|error: You must be logged in|401|error: the server has asked for the client to provide credentials' "${attempt_stderr}"; then
  echo "with-gates-kubeconfig: credential rejected — refreshing once and retrying" >&2
  # The refresh writes under /etc; this wrapper is the pushing user. `sudo -n` is
  # how the write happens without a prompt a pre-push hook could not answer.
  if [ "$(id -u)" -eq 0 ]; then
    refresh_argv=("${REFRESH}")
  else
    refresh_argv=(sudo -n "${REFRESH}")
  fi
  if ! "${refresh_argv[@]}"; then
    echo "with-gates-kubeconfig: refresh FAILED; original failure stands" >&2
    exit "${status}"
  fi
  "$@"
  exit $?
fi

exit "${status}"
