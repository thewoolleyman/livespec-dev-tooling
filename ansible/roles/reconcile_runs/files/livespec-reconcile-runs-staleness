#!/usr/bin/env bash
# Dead-man check for the reconcile-runs timers (role reconcile_runs).
#
# usage: livespec-reconcile-runs-staleness <bound-seconds> [<tenant>=<marker>]...
#
# Each marker is touched by its tenant's reconcile-runs.service ExecStartPost,
# which runs only after a pass that exits 0. A marker that is missing or older
# than the bound means that tenant's reconciler has not completed a pass within
# the bound; this exits 1 and names the tenant and the age, so the unit fails
# and a reader of the journal or the failed-unit list sees which tenant.
set -euo pipefail

bound="${1:?bound seconds required}"
shift
[[ "${bound}" =~ ^[0-9]+$ ]] || { printf 'reconcile-runs-staleness: bound %s is not a whole number of seconds\n' "${bound}" >&2; exit 64; }

now="$(date +%s)"
status=0
for pair in "$@"; do
  tenant="${pair%%=*}"
  marker="${pair#*=}"
  if [[ ! -e "${marker}" ]]; then
    printf 'reconcile-runs-stale tenant=%s age_seconds=missing bound_seconds=%s marker=%s\n' \
      "${tenant}" "${bound}" "${marker}"
    status=1
    continue
  fi
  age=$((now - $(stat -c %Y -- "${marker}")))
  if ((age > bound)); then
    printf 'reconcile-runs-stale tenant=%s age_seconds=%d bound_seconds=%s\n' "${tenant}" "${age}" "${bound}"
    status=1
  else
    printf 'reconcile-runs-fresh tenant=%s age_seconds=%d bound_seconds=%s\n' "${tenant}" "${age}" "${bound}"
  fi
done
exit "${status}"
