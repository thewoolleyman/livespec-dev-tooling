# {{ ansible_managed }}
# Host policy for {{ item.unit }}.service over livespec-orchestrator-beads-fabro's
# committed unit text (role reconcile_runs).
{% if item.after %}
[Unit]
# One pass at a time: this tenant's pass waits for the one before it in the sweep.
After={{ item.after }}.service

{% endif %}
[Service]
# The unit text's Restart=no stands: a failed pass is retried by the next sweep,
# so a hung tenant holds the serial sweep for one bound, not several.
TimeoutStartSec={{ reconcile_runs_timeout_seconds }}
# The dead-man marker. ExecStartPost runs only after ExecStart exits 0, so the
# marker's age is the age of this tenant's last successful pass.
ExecStartPost=/usr/bin/touch {{ item.marker }}
