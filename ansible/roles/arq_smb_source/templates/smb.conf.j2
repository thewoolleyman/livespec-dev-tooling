# Managed by Ansible (role: arq_smb_source). Local edits are overwritten.
#
# Canonical Samba config for the vps Arq backup source.
#
# Security model:
# - Samba itself binds only to loopback.
# - systemd-socket-proxyd exposes {{ arq_smb_source_tailscale_ip }}:445 to tailnet clients.
# - Nothing listens on eth0/public IPv4.
# - Authenticated SMB3 only.
# - Read-only share.
# - force user = root so Arq can read the VPS-created root-state snapshot;
#   access is guarded by Tailscale ACLs + the generated SMB password in
#   {{ arq_smb_source_password_file }}.

[global]
   server role = standalone server
   workgroup = WORKGROUP
   server string = vps Arq backup source

   interfaces = {{ arq_smb_source_loopback_address }}
   bind interfaces only = yes
   smb ports = 445
   disable netbios = yes

   map to guest = never
   restrict anonymous = 2
   usershare allow guests = no
   server min protocol = SMB3_00
   server signing = mandatory

   hosts allow = 127.
   hosts deny = 0.0.0.0/0

   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes

   log file = /var/log/samba/log.%m
   max log size = 1000
   panic action = /usr/share/samba/panic-action %d

[{{ arq_smb_source_share_name }}]
   comment = vps root-state snapshot for Arq backup
   path = {{ arq_smb_source_share_path }}
   browseable = no
   read only = yes
   guest ok = no
   valid users = {{ arq_smb_source_user }}
   force user = root
   force group = root
   follow symlinks = yes
   wide links = no
   hide unreadable = no
   dont descend = /dev /proc /sys /run /tmp /var/tmp /var/cache /var/lib/docker /var/lib/containerd /var/lib/dpkg/info /mnt /media /lost+found /snap
