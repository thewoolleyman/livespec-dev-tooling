# Rendered by the gha_runner role from this host's inventory values. Sourced by
# the launcher, the registrar, the token minter and the verifier under
# /usr/local/libexec/; they read these NAMES, so the role and the scripts
# agree by construction on what a host value is called.
GHA_RUNNER_USER="{{ gha_runner_user }}"
GHA_RUNNER_GROUP="{{ gha_runner_group }}"
GHA_RUNNER_HOME="{{ gha_runner_home }}"
GHA_RUNNER_ROOT="{{ gha_runner_root }}"
GHA_RUNNER_DIR="{{ gha_runner_dir }}"
GHA_RUNNER_WORK="{{ gha_runner_work }}"
GHA_RUNNER_REPO="{{ gha_runner_repo }}"
GHA_RUNNER_NAME="{{ gha_runner_name }}"
GHA_RUNNER_LABELS="{{ gha_runner_labels }}"
GHA_RUNNER_GROUP_NAME="{{ gha_runner_group_name }}"
GHA_RUNNER_VERSION="{{ gha_runner_version }}"
GHA_RUNNER_TARBALL_SHA256="{{ gha_runner_tarball_sha256 }}"
GHA_RUNNER_JOB_PATH="{{ gha_runner_job_path }}"
GHA_RUNNER_JOB_ENV_WRAPPER="{{ gha_runner_job_env_wrapper }}"
GHA_RUNNER_REG_ENV_WRAPPER="{{ gha_runner_reg_env_wrapper }}"
GHA_RUNNER_REG_APP_ID_VAR="{{ gha_runner_reg_app_id_var }}"
GHA_RUNNER_REG_PRIVATE_KEY_VAR="{{ gha_runner_reg_private_key_var }}"
GHA_RUNNER_REG_INSTALLATION_ID_VAR="{{ gha_runner_reg_installation_id_var }}"
GHA_RUNNER_STOP_TIMEOUT_SEC="{{ gha_runner_stop_timeout_sec }}"
