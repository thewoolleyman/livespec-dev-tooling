[Unit]
Description=1Password desktop (in vnc-desktop X session, 2h hard cap)
After=vnc-desktop.service
Requires=vnc-desktop.service

[Service]
Type=simple
User=ubuntu
# DISPLAY + DBUS_SESSION_BUS_ADDRESS are written by vnc-desktop-start.sh so
# 1Password attaches to the same X server and session bus as openbox/Chrome.
EnvironmentFile=/run/vnc-desktop/session.env
ExecStart=/usr/bin/1password --silent
# Hard cap on uptime — even if you forget to lock, the process is terminated
# 2h after start and its memory is reclaimed. Relaunch via:
#   sudo systemctl restart 1password-desktop   (openbox menu has this entry)
RuntimeMaxSec=2h
Restart=no
TimeoutStopSec=10

# Intentionally no [Install] section. This service is started on demand by
# x11vnc's -afteraccept hook (see services/vnc-desktop/vnc-desktop-start.sh)
# when a VNC client successfully authenticates. Skipping boot-time autostart
# means the 2h cap starts when you actually connect, not at boot — and we
# don't burn ~200MB RAM during idle hours.
