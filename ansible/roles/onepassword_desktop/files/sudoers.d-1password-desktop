# Allow the ubuntu user to drive the 1password-desktop service from the
# openbox right-click menu in VNC without a password prompt. Scoped tightly
# to the three lifecycle verbs we need; nothing else.
ubuntu ALL=(root) NOPASSWD: /usr/bin/systemctl start 1password-desktop, /usr/bin/systemctl start 1password-desktop.service, /usr/bin/systemctl stop 1password-desktop, /usr/bin/systemctl stop 1password-desktop.service, /usr/bin/systemctl restart 1password-desktop, /usr/bin/systemctl restart 1password-desktop.service
