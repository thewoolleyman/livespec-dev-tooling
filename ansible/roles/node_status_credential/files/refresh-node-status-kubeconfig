#!/usr/bin/env bash
# refresh-node-status-kubeconfig — re-fetch THIS agent node's node-status
# kubeconfig from the cluster's control-plane node.
#
# WHY THIS EXISTS AT ALL, rather than the attended re-seed it replaces. The
# control-plane node's k3s datastore is a tmpfs and is EMPTY at every boot
# (../../../../ci-runner/k3s/phase2/datastore-tmpfs/), so the per-node
# `node-status-patcher-<node>` ServiceAccount and its token Secret are RECREATED
# on each boot, and a kubeconfig delivered once carries a token the fresh API
# server has never seen. Every call then answers "the server has asked for the
# client to provide credentials". Measured 2026-10-12 04:01Z-04:26Z on
# gmktec-xubuntu: the node was Ready and registered while
# reapply-node-extended-resource.service printed "waiting for node
# gmktec-xubuntu to register..." and the node advertised no
# `ci-runner.io/churn-slot` capacity at all (livespec-dev-tooling-yj25uj). Until
# this script existed, the documented repair was a re-apply of the
# node_status_credential role by an operator — which is an operator step standing
# between a reboot and the pool's capacity.
#
# IT IS ../../gates_kubeconfig/files/refresh-gates-kubeconfig's SHAPE ON PURPOSE,
# AND THAT IS THE POINT. Same pull-not-push reasoning, same fail-closed posture,
# same "the token never touches a terminal and never reaches an argv" discipline,
# same temp-file-and-rename write. A credential repaired by a second,
# differently-shaped mechanism is a second mechanism to audit and a second one to
# get wrong. Its caller is
# ../../../../ci-runner/k3s/phase2/node-extended-resource/patch-node-churn-capacity.sh,
# which invokes it ONCE on a rejection exactly as `with-gates-kubeconfig` does.
#
# WHY A PULL RATHER THAN A PUSH. A push from the control-plane node would need it
# to hold an ssh credential toward every agent and to know each agent's address.
# A pull needs only what the agent already reaches the server with, it retries
# naturally, and it fails closed: if it cannot fetch, it writes nothing and
# leaves the existing file alone.
#
# WHAT IT FETCHES IS NOT CLUSTER-ADMIN, and the remote verb is `sudo cat` and
# nothing else. The bytes this places grant `get` and `patch` on ONE node's
# `nodes/status` — not the node's `spec` (so they cannot lift the node's own
# NoSchedule taint), not `delete`, not any other node; read
# ../../../../ci-runner/k3s/phase2/node-status-credential/node-status-patch-rbac.yaml
# for the whole grant. The remote path is re-rendered on every boot by the
# control-plane node's own converge (phase2/reconstruct/converge-ci-stack.sh),
# so what this fetches is always current and this script mints nothing.
#
# THE TOKEN NEVER TOUCHES A TERMINAL AND NEVER REACHES AN ARGV. It is piped from
# the remote `cat` into a shell variable and out again over STDIN, never as a
# command-line argument. Nothing here echoes the value, and the script's own
# output names only paths and outcomes.
#
# Idempotent: re-running is the supported repair path. Safe to run when the
# current file is already valid — it simply rewrites identical bytes.
set -euo pipefail

# The pool facts this tool needs, delivered by the node_status_credential role
# rather than baked in: which node this is, which host renders its credential,
# where that render lands, and where this node reads it from. The path defaults
# are conventions, so an un-provisioned host still fails against the right paths
# instead of against empty strings.
#
# THE CONTROL-PLANE NODE HAS NO DEFAULT, AND THE REFUSAL IS THE POINT. A machine
# is bound only through the inventory (livespec-dev-tooling-prdxxe), and the role
# resolves it from the `ci_pool` member whose `cluster_role` is `server`. A
# literal here was a SECOND spelling of that one pool fact, and two spellings can
# disagree with nothing naming the mismatch — the losing one fetching a bearer
# token from a host that is not this pool's control plane at all. Refusing names
# the variable; a wrong name would have contacted the wrong host first.
NODE_STATUS_REFRESH_ENV="${NODE_STATUS_REFRESH_ENV:-/etc/ci-runner/node-status-refresh.env}"
# shellcheck source=/dev/null
[ -r "${NODE_STATUS_REFRESH_ENV}" ] && . "${NODE_STATUS_REFRESH_ENV}"
NODE_NAME="${NODE_STATUS_NODE_NAME:-$(uname -n)}"
REMOTE_PATH="${NODE_STATUS_REMOTE_KUBECONFIG:-/etc/ci-runner/node-status-${NODE_NAME}.kubeconfig}"
DEST="${NODE_STATUS_KUBECONFIG:-/etc/rancher/k3s/node-status-kubeconfig}"
SSH_USER="${NODE_STATUS_SSH_USER:-cwoolley}"
# A bearer token is owner-only or it is not a secret — the mode, owner and group
# ../../../../ci-runner/k3s/secret-reinjection/seed-node-status-kubeconfig.sh
# writes, and the role delivers, so a refresh never widens what it replaces.
# Unlike the gates credential there is no reader group here: the only consumer is
# a root systemd unit on this node.
DEST_OWNER=root
DEST_GROUP=root
DEST_MODE=0600

log() { printf '%s refresh-node-status-kubeconfig: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

if [ -z "${NODE_STATUS_REMOTE_HOST:-}" ]; then
  log "NODE_STATUS_REMOTE_HOST is unset; the node_status_credential role renders it into ${NODE_STATUS_REFRESH_ENV} from the ci_pool member whose cluster_role is server"
  exit 1
fi
REMOTE_HOST="${NODE_STATUS_REMOTE_HOST}"

# The fetch, routed through SSH_USER's identity when we hold root and that user
# is not root. The caller is a root systemd unit, and root on a pool node has no
# tailnet ssh identity of its own, so `sudo -u <user> -H` gives ssh that user's
# HOME and therefore their ~/.ssh key and config. The token is produced only on
# this function's stdout and captured into a variable — it never reaches a
# terminal or a temp file of its own.
ssh_fetch() {
  if [ "$(id -u)" -eq 0 ] && [ "${SSH_USER}" != root ]; then
    sudo -u "${SSH_USER}" -H ssh -o BatchMode=yes -o ConnectTimeout=15 \
      "${REMOTE_HOST}" "sudo cat ${REMOTE_PATH}"
  else
    ssh -o BatchMode=yes -o ConnectTimeout=15 "${REMOTE_HOST}" "sudo cat ${REMOTE_PATH}"
  fi
}

# Fetch into memory, not into a file of its own: a loose temp file holding a
# bearer token for the length of a fetch is a window this design does not need to
# open. The only file the token ever reaches is the destination's own 0600
# stand-in, created and renamed within the write step below.
if ! rendered="$(ssh_fetch 2>/dev/null)"; then
  log "FAILED to fetch ${REMOTE_HOST}:${REMOTE_PATH} — leaving ${DEST} unchanged"
  log "check: ${REMOTE_HOST} reachable from this node as ${SSH_USER} (root drops to that identity via sudo -u), sudo available there, and its boot converge has rendered ${REMOTE_PATH} for node ${NODE_NAME}"
  exit 1
fi

# A truthful-looking but empty or malformed answer is worse than a failure,
# because it would overwrite a good credential with a useless one — and the next
# rejection would then be unrecoverable rather than self-healing. Require the two
# markers a rendered kubeconfig must carry before writing anything.
if ! printf '%s' "${rendered}" | grep -q '^kind: Config$' \
   || ! printf '%s' "${rendered}" | grep -q 'server:'; then
  log "FETCHED CONTENT IS NOT A KUBECONFIG — refusing to overwrite ${DEST}"
  exit 1
fi

install -d -m 0755 "$(dirname "${DEST}")"

# THE WRITE IS A TEMP FILE AND A RENAME, NOT `install /dev/stdin "${DEST}"`.
# uutils coreutils — what Ubuntu 25.10 and 26.04 ship INSTEAD of GNU coreutils,
# and what this pool's nodes run — fails `install` with `install: No such file or
# directory` (exit 1) whenever the DESTINATION operand already exists. A refresh
# is called PRECISELY when the destination is already there and stale, so that
# idiom would have made this script work once and fail every time after
# (livespec-dev-tooling-74q6iw, measured 2026-10-11 on uutils 0.2.2 and 0.8.0).
#
# A temp file in the DESTINATION's own directory, created under `umask 077` so it
# is never readable beyond its owner for even an instant, given the destination's
# ownership and mode, and then renamed over the destination, is atomic, keeps the
# token off every argv, and behaves identically under GNU coreutils and uutils.
tmp_dest="$(umask 077 && mktemp "${DEST}.refresh.XXXXXX")"
trap 'rm -f -- "${tmp_dest}"' EXIT
printf '%s\n' "${rendered}" | tee "${tmp_dest}" > /dev/null
unset rendered

# OWNERSHIP BEFORE MODE, AND BOTH BEFORE THE RENAME, so the rename publishes a
# file that was never readable beyond its owner while it was being written. Only
# root can give a file away, and only root ever needs to: the caller is a root
# systemd unit. Run interactively by a user who owns the destination, the chown
# is skipped and the mode still lands.
if [ "$(id -u)" -eq 0 ]; then
  if ! chown "${DEST_OWNER}:${DEST_GROUP}" "${tmp_dest}"; then
    log "FAILED to set ${DEST_OWNER}:${DEST_GROUP} on the replacement — leaving ${DEST} unchanged"
    exit 1
  fi
fi
chmod "${DEST_MODE}" "${tmp_dest}"
mv -f "${tmp_dest}" "${DEST}"
trap - EXIT
log "refreshed ${DEST} from ${REMOTE_HOST}:${REMOTE_PATH} (${DEST_OWNER}:${DEST_GROUP}, mode ${DEST_MODE})"
