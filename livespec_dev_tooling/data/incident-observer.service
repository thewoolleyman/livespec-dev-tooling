[Unit]
Description=Independent released incident observer
After=network-online.target
Wants=network-online.target
# A crash loop must end in `failed`, visibly, not restart forever: the default limit
# (5 starts in 10 s) can never trip with RestartSec=2 plus any run time. Five starts in
# 300 s lets a transient failure (a tenant blip, a port still held) recover by itself,
# while a deterministic crash on every start lands in `failed` after five starts: about
# 10 s for a fast crash, starts spaced RestartSec=2 apart. Once tripped, systemd refuses
# a plain restart until the interval passes, so the role's restart handler clears the
# state with `systemctl reset-failed` first.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=livespec-incident
Group=livespec-incident
WorkingDirectory=/var/lib/livespec-incident
ExecStart=/opt/livespec-incident/venv/bin/python -I -m livespec_dev_tooling.incident_observer_service --config /etc/livespec-incident/controller.json
Environment=PATH=/opt/livespec-incident/venv/bin:/usr/local/bin:/usr/bin:/bin
UnsetEnvironment=PYTHONPATH PYTHONHOME GIT_CONFIG GIT_CONFIG_COUNT GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_ALTERNATE_OBJECT_DIRECTORIES EXPEDITED_INCIDENT_RESPONSE EXPEDITED_INCIDENT_RESPONSE_REVERT LIVESPEC_INCIDENT_CONTEXT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/livespec-incident /etc/livespec-incident
ReadWritePaths=/var/lib/livespec-incident
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
