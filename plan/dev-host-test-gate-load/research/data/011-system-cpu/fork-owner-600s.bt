tracepoint:sched:sched_process_fork {
  $t = curtask; $o = (uint64)0; $direct = (uint64)0; $found = 0; $top = (uint64)0;
  if ($t->comm == "claude") { $direct = 1; }
  unroll(14) {
    if ($found == 0 && $t->tgid > 1) {
      if ($t->comm == "claude") { $o = (uint64)$t->tgid; $found = 1; }
      if ($t->real_parent->tgid <= 1) { $top = (uint64)$t->tgid; }
      $t = $t->real_parent;
    }
  }
  if ($found == 1) { @seat[$o, $direct] = count(); } else { @other[$top] = count(); }
  @total = count();
}
interval:s:600 { exit(); }
