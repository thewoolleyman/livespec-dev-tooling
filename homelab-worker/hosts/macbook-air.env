# Homelab worker host declaration: macbook-air (Apple M5, 10 cores, 32 GiB,
# ~878 GB free; plan homelab-k8s-worker-nodes research/001). Data only — every
# declared host runs the same start script (SPECIFICATION/non-functional-
# requirements.md, "Homelab worker nodes": "Start task and declared hosts").
# The VM budget leaves most of the machine to its interactive development use;
# it is an initial envelope, not a pod or churn-slot cap.
WORKER_HOST_OS=Darwin
WORKER_VM_CPUS=6
WORKER_VM_MEMORY_GIB=16
WORKER_VM_DISK_GIB=150
