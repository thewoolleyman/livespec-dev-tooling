# Homelab worker host declaration: macbook-m4-max (Apple M4 Max, 16 cores,
# 128 GiB, ~2.7 TiB free; macbook-m4-max-info c2b2a63). Data only — every
# declared host runs the same start script (SPECIFICATION/non-functional-
# requirements.md, "Homelab worker nodes": "Start task and declared hosts").
# The VM budget is an initial envelope for the single worker VM, not a pod or
# churn-slot cap; it is re-derived from measured throughput before admission.
WORKER_HOST_OS=Darwin
WORKER_VM_CPUS=12
WORKER_VM_MEMORY_GIB=64
WORKER_VM_DISK_GIB=100
WORKER_DATA_DISK_GIB=300
# Static home-LAN address of the worker VM's bridged lima0, outside the
# router's DHCP pool (192.168.1.2-.200; home-tech-infrastructure#2).
WORKER_LAN_ADDRESS=192.168.1.201/24
# The host's LAN interface for Lima's bridged network: Wi-Fi (en0). The wired
# USB adapter (en7) served 2026-11-11 15:54Z to 2026-11-12 ~01:00Z and was
# faster on every path, but the maintainer returned the host to Wi-Fi only on
# 2026-11-12, and the slow overlay it was tried against turned out to be a
# poweredge bnx2x transmit bug, not this link (plan homelab-k8s-worker-nodes
# research 011; ansible role vxlan_tunnel_tso). The start task checks this
# value and never writes it.
WORKER_LAN_INTERFACE=en0
