# The node's host collector (plan homelab-k8s-worker-nodes, DoD assertion 18):
# host metrics into the livespec Honeycomb environment with host.name = the
# node name. Its configuration is the otel-collector repository's
# config.homelab-worker.yaml, delivered by the start task at a pinned commit;
# .env carries the ingest key, delivered on stdin. Pod spans run in the sibling
# otel-collector-pods.service, because cni0 does not exist until the first pod
# lands and its bind failure must not silence host metrics.
[Unit]
Description=OpenTelemetry Collector (homelab worker host metrics)
After=network-online.target kubelet.service
ConditionPathExists=/etc/otel-collector/config.yaml
ConditionPathExists=/etc/otel-collector/.env

[Service]
EnvironmentFile=/etc/otel-collector/.env
ExecStart=/usr/local/bin/otelcol-contrib --config=/etc/otel-collector/config.yaml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
