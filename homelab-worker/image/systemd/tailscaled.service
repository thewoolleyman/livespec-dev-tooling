# Kernel-mode Tailscale inside the worker's own network namespace, so the
# worker joins the tailnet as <host>-homelab-worker and the host's own identity
# is untouched. The worker is an ordinary untagged autogroup:member device: it
# carries no auth key and advertises no tag (tailscale-admin retired tags
# fleet-wide, maintainer ruling 2026-08-17). The start task runs the one
# interactive login while the device still needs it, and the maintainer
# approves the URL it prints. Device state persists in /var/lib/tailscale, on
# the worker data disk, so a restart reconnects without another login.
[Unit]
Description=Tailscale node agent (homelab worker identity)
After=network-pre.target
Wants=network-pre.target

[Service]
ExecStart=/usr/local/sbin/tailscaled --state=/var/lib/tailscale/tailscaled.state --socket=/run/tailscale/tailscaled.sock --tun=tailscale0
RuntimeDirectory=tailscale
Restart=on-failure

[Install]
WantedBy=multi-user.target
