// Project-local livespec configuration for livespec-dev-tooling.
//
// This sibling library dogfoods livespec at the LIBRARY scale (distinct
// from the plugin scale via livespec-core itself, and the impl-plugin
// scale via livespec-orchestrator-git-jsonl). The SPECIFICATION/ tree at the
// repo root is the live spec for this library; this library's own impl
// tracking lives in a per-repo beads/Dolt TENANT database on the shared
// dolt-server (tenant name "livespec-dev-tooling"), via livespec-orchestrator-beads-fabro.
// (The pre-cutover plaintext work-items.jsonl / memos.jsonl snapshot is
// frozen read-only under archive/ — see archive/README.md.)
//
// Authority: livespec/SPECIFICATION/contracts.md
//   §"Cross-repo coordination — pin-and-bump" (generalized in v070 to
//   cover sibling libraries as well as impl-plugins)
//   §"Shared code sync — livespec-dev-tooling" (added in v070; this
//   file is the canonical example of a sibling-library `compat` block
//   declared under a library-name top-level key)
//
// Status: SPECIFICATION/ is empty until Phase G.3 of epic li-fgqgnk
// runs `/livespec:seed`. Until then, livespec sub-commands targeting
// this tree will fail-fast with a precondition error directing the
// user to seed first.
{
  // Worktree-discipline pack policy. "required" — the DEFAULT, and what an
  // absent key means — makes `just check` fail when the canonical pack is not
  // installed and imported by the root justfile. "optional" is the sanctioned,
  // reviewable opt-out. Written explicitly at install time so the obligation is
  // readable here rather than inferred from a verifier failure.
  "worktree_discipline": { "pack": "required" },
  "template": "livespec",
  "spec_root": "SPECIFICATION",
  "implementation": { "plugin": "livespec-orchestrator-beads-fabro" },
  // Credential-injection wrapper (fleet default) prefixed to the beads CLIs so a bare invocation self-heals its tenant secret.
  "credential_wrapper": ["/usr/local/bin/with-livespec-env.sh", "--"],
  // Cross-harness plugin-resolution (Conformance Pattern concern #2): this
  // library ships no command/skill surface to resolve from a harness, so both
  // harnesses are declared exempt. The always-on `check-plugin-resolution`
  // declaration-integrity gate (wired into `just check`) reads this.
  "harnesses": {
    "claude": { "status": "exempt", "reason": "livespec-dev-tooling is an enforcement-suite library; it ships no command/skill surface to resolve from a harness" },
    "codex":  { "status": "exempt", "reason": "livespec-dev-tooling is an enforcement-suite library; it ships no command/skill surface to resolve from a harness" }
  },
  // Allowlist for the upstream governance heading cited by SPECIFICATION/README.md.
  "external_references": {
    "livespec": [
      "SPECIFICATION/non-functional-requirements.md §\"Cross-repo coordination — pin-and-bump\"",
      "SPECIFICATION/contracts.md §\"Doctor cross-boundary invariants\"",
      "SPECIFICATION/contracts.md §\"Driver-shipped hooks\"",
      "SPECIFICATION/contracts.md §\"Plugin versioning\"",
      "SPECIFICATION/constraints.md §\"Vendored-library discipline\"",
      "SPECIFICATION/contracts.md §\"`primary-checkout-commit-refuse-hook-installed`\"",
      "SPECIFICATION/non-functional-requirements.md §\"CI as a merge gate (branch protection)\"",
      "SPECIFICATION/non-functional-requirements.md §\"Commit-refuse hook bootstrap procedure\"",
      "SPECIFICATION/non-functional-requirements.md §\"Conformance Pattern\"",
      "SPECIFICATION/non-functional-requirements.md §\"Fleet membership contract\"",
      "SPECIFICATION/non-functional-requirements.md §\"Governed-repo lifecycle\"",
      "SPECIFICATION/non-functional-requirements.md §\"Keyword-only arguments\"",
      "SPECIFICATION/non-functional-requirements.md §\"Workflow discipline — spec-side changes\"",
      "SPECIFICATION/non-functional-requirements.md §\"ROP composition\"",
      "SPECIFICATION/non-functional-requirements.md §\"Shared code sync — livespec-dev-tooling\"",
      "SPECIFICATION/non-functional-requirements.md §\"Sibling spec ownership\"",
      "SPECIFICATION/non-functional-requirements.md §\"Test-Driven Development discipline\"",
      "SPECIFICATION/non-functional-requirements.md §\"Toolchain pins\""
    ]
  },
  // Planning/work-item-resolution registry. These targets are the repo slugs
  // accepted by cross-tenant DependsOnEntry refs (`sibling_work_item`,
  // `pull_request`, and `branch`).
  "cross_repo_targets": {
    "livespec": {
      "github_url": "https://github.com/thewoolleyman/livespec",
      "local_clone": "/data/projects/livespec",
      "default_branch": "master"
    }
  },
  "livespec-dev-tooling": {
    "compat": {
      // semver range and pinned tag against livespec-core. The pinned
      // value is "master" until livespec-core cuts its first post-v070
      // release tag (Phase G.6 is the natural moment to bump these to
      // a real tag); doctor's contract-version-compatibility invariant
      // currently fires `warn` against "master" pins, which is expected
      // during bootstrap.
      "livespec": ">=0.1.0,<1.0.0",
      "pinned": "v0.27.1"
    }
  },
  "livespec-orchestrator-beads-fabro": {
    "format": "beads",
    "compat": { "livespec": ">=0.1.0,<1.0.0", "pinned": "v0.27.1" },
    // Per-repo beads tenant CONNECTION block. tenant==database==server_user is the load-bearing
    // tenant identity (one ≤32-char Dolt name serving all three). The beads issue-ID `prefix` is
    // bd's server-stored create-prefix — a short alias that MAY be DECOUPLED from the tenant DB
    // name (here it equals the tenant, but is no longer a required rule — e.g. the orchestrator
    // tenants use `bd-ib`/`bd-gj`). The tenant PASSWORD is deliberately ABSENT — supplied only via
    // the BEADS_DOLT_PASSWORD env var at bd-call time, never committed. TCP-only (the dolt.sock is
    // not reachable by sandboxed callers), so no `socket` key.
    "connection": {
      "tenant": "livespec-dev-tooling",
      "prefix": "livespec-dev-tooling",
      "database": "livespec-dev-tooling",
      "server_user": "livespec-dev-tooling",
      "server_host": "127.0.0.1",
      "server_port": 3307,
      "fake": false
    },
    // Autonomous-mode levers (maintainer-directed 2026-07-20). Two of the three
    // policy settings in livespec/SPECIFICATION/contracts.md §"The three policy
    // settings" are moved off their safe defaults so ready work is ADMITTED and
    // ACCEPTED without a human valve:
    //   auto_approve_ready: true      — pending-approval → ready with no human.
    //   acceptance_mode: "ai-only"    — post-merge acceptance without a human.
    // The third lever, `merge_on_review_cap`, deliberately STAYS at its safe
    // `false` default and is NOT listed here: a review that cannot converge
    // within `review_fix_cap` rounds is precisely the case that must reach a
    // human, per the design record cited in that section. A design-human-gated
    // (spec-change-tier) item still cannot auto-approve regardless of these.
    //
    // EDIT THIS BLOCK BY HAND. Do NOT use `drive --action set-config:<k>:<v>`:
    // that surface round-trips the file through json.dumps and silently strips
    // every comment here while reporting green — tracked as bd-ib-lmi5.
    "dispatcher": {
      "auto_approve_ready": true,
      "acceptance_mode": "ai-only"
    }
  }
}
