// Project-local livespec configuration for livespec-dev-tooling.
//
// This sibling library dogfoods livespec at the LIBRARY scale (distinct
// from the plugin scale via livespec-core itself, and the impl-plugin
// scale via livespec-orchestrator-git-jsonl). The SPECIFICATION/ tree at the
// repo root is the live spec for this library; this library's own impl
// tracking lives in a per-repo beads/Dolt TENANT database on the shared
// dolt-server (tenant name "livespec-dev-tooling"), via livespec-orchestrator-beads-fabro.
// (The pre-cutover plaintext work-items.jsonl / memos.jsonl snapshot is
// frozen read-only under archive/ — see archive/README.md.)
//
// Authority: livespec/SPECIFICATION/contracts.md
//   §"Cross-repo coordination — pin-and-bump" (generalized in v070 to
//   cover sibling libraries as well as impl-plugins)
//   §"Shared code sync — livespec-dev-tooling" (added in v070; this
//   file is the canonical example of a sibling-library `compat` block
//   declared under a library-name top-level key)
//
// Status: SPECIFICATION/ is empty until Phase G.3 of epic li-fgqgnk
// runs `/livespec:seed`. Until then, livespec sub-commands targeting
// this tree will fail-fast with a precondition error directing the
// user to seed first.
{
  // Worktree-discipline pack policy. "required" — the DEFAULT, and what an
  // absent key means — makes `just check` fail when the canonical pack is not
  // installed and imported by the root justfile. "optional" is the sanctioned,
  // reviewable opt-out. Written explicitly at install time so the obligation is
  // readable here rather than inferred from a verifier failure.
  "worktree_discipline": { "pack": "required" },
  "git_author": {
    "operator_name": "Chad Woolley",
    "operator_email": "thewoolleyman@gmail.com",
    "mechanical_authors": [
      { "name": "thewoolleyman-factory-bot[bot]", "email": "thewoolleyman-factory-bot[bot]@users.noreply.github.com" },
      { "name": "thewoolleyman-factory-bot[bot]", "email": "283469463+thewoolleyman-factory-bot[bot]@users.noreply.github.com" }
    ]
  },
  "template": "livespec",
  "spec_root": "SPECIFICATION",
  "implementation": { "plugin": "livespec-orchestrator-beads-fabro" },
  // ACTIVE spec_governance overrides. Fleet-wide autonomy-lever rollout
  // (epic livespec-jvdvx4, child livespec-jvdvx4.15, 2026-08-16): every
  // Increment-1/2 lever livespec core shipped is armed to its safe
  // fully-autonomous value except the two intentionally left out below.
  //   propose_change_mode: "batch" — non-interactive propose-change.
  //   critique_mode: "batch" — non-interactive critique.
  //   in_flight_alignment: "default-align" — no prompt on in-flight drift.
  //   revise_decision_mode: "delegated" — non-drift proposals decide without
  //     a manual gate (design-record-contradiction/absence and reviewer
  //     blockers still hard-floor to the maintainer regardless).
  //   ratification_review: "auto-spawn" — the independent adversarial review
  //     spawns automatically instead of waiting on a manual trigger.
  //   ratification_reviewer_model: "fable" — the reviewer model the auto-spawn
  //     uses. REQUIRED for auto-spawn to function: livespec core's
  //     effective_ratification_review falls back to the manual path whenever
  //     this key is unset, so arming the lever alone leaves it inert.
  //   spec_pr_merge: "auto-on-green" — a governed spec PR merges once CI is
  //     green, no manual merge click.
  // Intentionally NOT armed here:
  //   doctor_dispositions — left unpopulated (defaults every finding to
  //     escalate). Populating it is a judgment-heavy, per-check-id audit
  //     scoped to a dedicated follow-up, not this mechanical rollout pass.
  //   drift_acceptance_mode — has no safe non-human value yet; its only
  //     alternative (consensus) is inert pending the not-yet-built
  //     Increment-3 cross-vendor panel, so it stays at the default "human".
  "spec_governance": {
    "propose_change_mode": "batch",
    "critique_mode": "batch",
    "in_flight_alignment": "default-align",
    "revise_decision_mode": "delegated",
    "ratification_review": "auto-spawn",
    "ratification_reviewer_model": "fable",
    "spec_pr_merge": "auto-on-green"
  },
  // Optional — spec_governance: policy levers for livespec's spec-side
  // operations. The commented defaults below are derived from the shipped
  // spec-governance manifest and no longer reflect this repo's ACTIVE
  // values (see the block above) — kept only as the schema reference for
  // what a key looks like if reverted to its shipped default.
  // To enable any key, add the block as a real key above (a comma after the
  // `harnesses` block) and keep only the entries this repo intentionally
  // overrides:
  //   "spec_governance": {
  //     // propose_change_mode (enum; allowed: "interactive", "batch")
  //     "propose_change_mode": "interactive",
  //     // critique_mode (enum; allowed: "interactive", "batch")
  //     "critique_mode": "interactive",
  //     // in_flight_alignment (enum; allowed: "prompt", "default-align")
  //     "in_flight_alignment": "prompt",
  //     // doctor_dispositions (map; allowed values: "fix-now",
  //     // "capture-as-work-item", "propose-change", "defer", "dismiss")
  //     "doctor_dispositions": {},
  //     // revise_decision_mode (enum; allowed: "manual", "delegated",
  //     // "consensus"; per-proposal override: decision_policy)
  //     "revise_decision_mode": "manual",
  //     // drift_acceptance_mode (enum; allowed: "human", "consensus")
  //     "drift_acceptance_mode": "human",
  //     // ratification_review (enum; allowed: "manual-spawn", "auto-spawn";
  //     // per-proposal override: ratification_review_policy)
  //     "ratification_review": "manual-spawn",
  //     // ratification_reviewer_model (string; no enumerated allowed values)
  //     "ratification_reviewer_model": null,
  //     // ratification_min_review_age_seconds (integer; minimum: 1)
  //     "ratification_min_review_age_seconds": 1,
  //     // spec_pr_merge (enum; allowed: "manual", "auto-on-green")
  //     "spec_pr_merge": "manual"
  //   }
  //
  // Credential-injection wrapper (fleet default) prefixed to the beads CLIs so a bare invocation self-heals its tenant secret.
  "credential_wrapper": ["/usr/local/bin/with-livespec-env.sh", "--"],
  // Cross-harness plugin-resolution (Conformance Pattern concern #2): this
  // library ships no command/skill surface to resolve from a harness, so both
  // harnesses are declared exempt. The always-on `check-plugin-resolution`
  // declaration-integrity gate (wired into `just check`) reads this.
  "harnesses": {
    "claude": { "status": "exempt", "reason": "livespec-dev-tooling is an enforcement-suite library; it ships no command/skill surface to resolve from a harness" },
    "codex":  { "status": "exempt", "reason": "livespec-dev-tooling is an enforcement-suite library; it ships no command/skill surface to resolve from a harness" }
  },
  // Allowlist for the upstream governance heading cited by SPECIFICATION/README.md.
  "external_references": {
    "livespec": [
      "SPECIFICATION/non-functional-requirements.md §\"Cross-repo coordination — pin-and-bump\"",
      "SPECIFICATION/contracts.md §\"Doctor cross-boundary invariants\"",
      "SPECIFICATION/contracts.md §\"Driver-shipped hooks\"",
      "SPECIFICATION/contracts.md §\"Plugin versioning\"",
      "SPECIFICATION/constraints.md §\"Vendored-library discipline\"",
      "SPECIFICATION/contracts.md §\"`primary-checkout-commit-refuse-hook-installed`\"",
      "SPECIFICATION/non-functional-requirements.md §\"CI as a merge gate (branch protection)\"",
      "SPECIFICATION/non-functional-requirements.md §\"Self-hosted CI runner host requirements\"",
      "SPECIFICATION/non-functional-requirements.md §\"Commit-refuse hook bootstrap procedure\"",
      "SPECIFICATION/non-functional-requirements.md §\"Conformance Pattern\"",
      "SPECIFICATION/non-functional-requirements.md §\"Fleet membership contract\"",
      "SPECIFICATION/non-functional-requirements.md §\"Governed-repo lifecycle\"",
      "SPECIFICATION/non-functional-requirements.md §\"Keyword-only arguments\"",
      "SPECIFICATION/non-functional-requirements.md §\"Workflow discipline — spec-side changes\"",
      "SPECIFICATION/non-functional-requirements.md §\"ROP composition\"",
      "SPECIFICATION/non-functional-requirements.md §\"Shared code sync — livespec-dev-tooling\"",
      "SPECIFICATION/non-functional-requirements.md §\"Sibling spec ownership\"",
      "SPECIFICATION/non-functional-requirements.md §\"Test-Driven Development discipline\"",
      "SPECIFICATION/non-functional-requirements.md §\"Toolchain pins\""
    ],
    "livespec-orchestrator-beads-fabro": [
      "SPECIFICATION/contracts.md §\"Factory addresses resolved from a host registry\""
    ]
  },
  // Planning/work-item-resolution registry. These targets are the repo slugs
  // accepted by cross-tenant DependsOnEntry refs (`sibling_work_item`,
  // `pull_request`, and `branch`).
  "cross_repo_targets": {
    "livespec": {
      "github_url": "https://github.com/thewoolleyman/livespec",
      "local_clone": "/data/projects/livespec",
      "default_branch": "master"
    }
  },
  "livespec-dev-tooling": {
    "compat": {
      // semver range and pinned tag against livespec-core. The pinned
      // value is "master" until livespec-core cuts its first post-v070
      // release tag (Phase G.6 is the natural moment to bump these to
      // a real tag); doctor's contract-version-compatibility invariant
      // currently fires `warn` against "master" pins, which is expected
      // during bootstrap.
      "livespec": ">=0.1.0,<1.0.0",
      "pinned": "v0.42.1"
    }
  },
  "livespec-orchestrator-beads-fabro": {
    "format": "beads",
    "compat": { "livespec": ">=0.1.0,<1.0.0", "pinned": "v0.42.1" },
    // Per-repo beads tenant CONNECTION block. tenant==database==server_user is the load-bearing
    // tenant identity (one ≤32-char Dolt name serving all three). The beads issue-ID `prefix` is
    // bd's server-stored create-prefix — a short alias that MAY be DECOUPLED from the tenant DB
    // name (here it equals the tenant, but is no longer a required rule — e.g. the orchestrator
    // tenants use `bd-ib`/`bd-gj`). The tenant PASSWORD is deliberately ABSENT — supplied only via
    // the BEADS_DOLT_PASSWORD env var at bd-call time, never committed. TCP-only (the dolt.sock is
    // not reachable by sandboxed callers), so no `socket` key.
    "connection": {
      "tenant": "livespec-dev-tooling",
      "prefix": "livespec-dev-tooling",
      "database": "livespec-dev-tooling",
      "server_user": "livespec-dev-tooling",
      "server_host": "127.0.0.1",
      "server_port": 3307,
      "fake": false
    },
    // Autonomous-mode levers (maintainer-directed 2026-07-20). Two of the three
    // policy settings in livespec/SPECIFICATION/contracts.md §"The three policy
    // settings" are moved off their safe defaults so ready work is ADMITTED and
    // ACCEPTED without a human valve:
    //   auto_approve_ready: true      — pending-approval → ready with no human.
    //   acceptance_mode: "ai-only"    — post-merge acceptance without a human.
    // The third lever, `merge_on_review_cap`, deliberately STAYS at its safe
    // `false` default and is NOT listed here: a review that cannot converge
    // within `review_fix_cap` rounds is precisely the case that must reach a
    // human, per the design record cited in that section. A design-human-gated
    // (spec-change-tier) item still cannot auto-approve regardless of these.
    //
    // EDIT THIS BLOCK BY HAND. Do NOT use `drive --action set-config:<k>:<v>`:
    // that surface round-trips the file through json.dumps and silently strips
    // every comment here while reporting green — tracked as bd-ib-lmi5.
    "dispatcher": {
      // Committed mirror of the sandbox image's published capability set, read by
      // the Definition-of-Done gate and by the host-side judgements when
      // /etc/livespec/sandbox-capabilities is not reachable. MEASURED 2026-10-20 by
      // `docker run --rm --entrypoint cat ghcr.io/thewoolleyman/livespec-fabro-sandbox:python-agent-v1.118.7
      // /etc/livespec/sandbox-capabilities`, the image this repository's committed run
      // config resolves. Edit it by hand, in the same change that moves the image.
      "sandbox_capabilities": ["terminal", "tmux", "headless_browser", "herdr"],
      // Dispatch-time toolchain and conformance premises, in the shape the
      // Dispatcher's typed repository integration contract reads
      // (`dispatcher.prepare_toolchain.*`, `dispatcher.conformance.*`).
      //
      // WHY THESE ARE HERE AT ALL. Until livespec-orchestrator-beads-fabro
      // 39526e5c (2026-08-31) these five commands were HARDCODED in the
      // implement-work-item payload and ran for every dispatched sandbox in
      // the fleet. That commit turned each of them into a projection of the
      // governed repository's own declaration, whose fleet default is the
      // ratified explicit NO-OP. A repository that declares nothing therefore
      // no longer installs its pinned toolchain, no longer installs its hook
      // manager, and — the one that matters — no longer installs or verifies
      // the structural commit-refuse hook that fires the Red-Green-Replay
      // gates on every in-sandbox commit. Nothing fails when that happens:
      // the run proceeds and reads green. These declarations restore exactly
      // what this repository's sandboxes ran before that commit, and they are
      // copied verbatim from livespec-orchestrator-beads-fabro's own
      // .livespec.jsonc, which is the schema author and, at the time of
      // writing, the fleet's only other adopter.
      //
      // Only three of the five undeclared premises produce a dispatch-time
      // warning (the `conformance.*` trio); the two `prepare_toolchain.*`
      // ones go silently to no-op, which is why this was worth writing down
      // rather than leaving to the warning to surface.
      //
      // `internal_livespec_dev_tooling` carries a dependency on the
      // livespec-dev-tooling package. That is the cheapest possible
      // dependency HERE, because this repository IS that package: the mode
      // renders `uv run python -m livespec_dev_tooling.<module>`, and the
      // `uv sync --all-groups` prepare step immediately before it has already
      // put the package in the sandbox venv.
      //
      // NOTE: these declarations are INERT until the dispatch outage tracked
      // as livespec-orchestrator-beads-fabro `bd-ib-8atx` is fixed — fabro
      // 0.254.0 does not expand `{{ inputs.* }}` inside `run.prepare`, so
      // every dispatch currently dies in setup at exit 127 before any of
      // these values could be used. See
      // plan/archive/ci-runner-cache-tiers/research/008-factory-dispatch-outage.md.
      "prepare_toolchain": {
        "mise": ["sh", "-c", "mise trust && env -u GITHUB_TOKEN -u GH_TOKEN -u GITHUB_API_TOKEN mise install --quiet"],
        "lefthook": ["uv", "run", "lefthook", "install"]
      },
      "conformance": {
        "hook_install": { "mode": "internal_livespec_dev_tooling" },
        "verify_commit_refuse_hook": { "mode": "internal_livespec_dev_tooling" },
        "verify_plugin_resolution": { "mode": "internal_livespec_dev_tooling" }
      },
      "auto_approve_ready": true,
      "acceptance_mode": "ai-only",
      // AMENDED 2026-10-20 (coordinator R273, stability): implement is back on
      // claude-acp / claude-opus-5 / high PRIMARY with codex-acp / gpt-5.6-terra /
      // high as its fallback. Codex-Terra implement failed 3 of 4 runs with one
      // signature, LIVESPEC_IMPLEMENT_PARTIAL_PROGRESS (Red committed, Green amend
      // or the full hook interrupted); it returns to Codex only after the measured
      // root cause is fixed and one clean canary. fix stays on Terra for now.
      //
      // CURRENT ROUTING (2026-10-20, coordinator ruling R267, maintainer
      // direction to use all available tokens holistically). implement and fix
      // stay codex-acp / gpt-5.6-terra / high with their claude-opus-5 fallback.
      // Every other node is back on the Claude tier it ran before R261, with
      // its R261 Codex model as the fallback, so each run draws on both pools:
      // dod_gate, review and proof_verify on claude-opus-4-8 high, review_fix
      // and proof_capture on claude-opus-5 high (Terra high fallback), pr and
      // disposition on claude-sonnet-4-6 medium (Luna low fallback). KNOWN
      // DIFFERENCE from the built-in defaults: those rendered
      // claude-opus-4-8[1m], the 1M-context window, which a structured entry
      // cannot express (_acp_model_catalog's alias note), so these nodes run
      // the standard-context Opus 4.8.
      //
      // PREVIOUS ROUTING (2026-10-19, coordinator ruling R261, maintainer
      // direction: "switch factory nodes to codex corresponding models and use
      // those available tokens"). Every node is pinned Codex-primary, tier for
      // tier, replacing the built-in Claude defaults, which stay as each node's
      // fallback: the Opus-tier nodes run codex-acp / gpt-5.6-terra / high (their
      // fallback is the built-in default they had, claude-opus-5 or the review
      // input's claude-opus-4-8), and pr and disposition run codex-acp /
      // gpt-5.6-luna / low with a claude-sonnet-4-6 fallback. Both Codex models
      // answered a live ACP turn on the factory's Codex (ChatGPT) account that
      // day, which is the REVERT CONDITION the pr note below names; the refused
      // slugs that day were gpt-5.4-mini, gpt-5.4, gpt-5.3-codex-spark, gpt-6-luna
      // and gpt-6-sol. The note below records why `pr` was parked on Claude.
      // wip_cap is a LEDGER-CLAIMS cap, not a CPU-derived one, and every
      // dispatcher engine on this repo shares it. Lowered 10 -> 4 on
      // 2026-09-06 (maintainer-directed): with the drain filling the cap,
      // 7 concurrent dev-tooling runs, each a docker sandbox executing the
      // full `just check` aggregate, saturated the hp factory's CPU. Raise it
      // only from a measured capacity verdict on the factory host.
      //
      // Raised 4 -> 10 on 2026-09-08 (maintainer-directed) on exactly that
      // verdict, measured ON hp-xubuntu rather than inferred from the number
      // of runs in `fabro ps`: load average 2.55 / 1.83 / 1.28 across 16
      // cores, CPU 69.3% idle (23.7% user, 6.3% sys), 25 GB of 30 GB memory
      // available, 3 running containers. Taken while SIX dispatcher loops
      // were live across THREE tenants (dolt-server x3, dev-tooling x2,
      // runtime x1), so it is a loaded-host reading, not an idle-host one.
      //
      // The 2026-09-06 saturation above still stands as the ceiling evidence,
      // and note what it actually measured: 7 concurrent DEV-TOOLING runs.
      // This is a per-repo claims cap, so 10 only approaches that ceiling if
      // this repo alone fills it. Re-measure on the host (not from run
      // counts) before raising further.
      // Park the `pr` node on the Claude adapter, OFF Codex.
      //
      // WHY. `dispatcher.codex_models` expands UNCONDITIONALLY -- its `pr`
      // tier fires even for a repo (like this one) that configures no
      // `codex_models` block at all -- and pins the fleet default
      // `_DEFAULT_PR_MODEL = "gpt-5.4-mini"`. That pin is STALE against the
      // adapter this repo now bakes, and the publish leg is dead as a result:
      //
      //   run 01M20W5GPEK6945EXGE2PS68CS (livespec-dev-tooling-ys2i),
      //   2026-09-08, stages/006-pr@1:
      //     Warning: Model metadata for `gpt-5.4-mini` not found.
      //     {"status":400,"error":{"message":"The 'gpt-5.4-mini' model is not
      //      supported when using Codex with a ChatGPT account."}}
      //
      // implement, janitor and review all PASSED (003-implementation_diff
      // exited 0, i.e. `git diff --quiet` returned 1 -- there was a diff);
      // only `pr` died, so the work was done and stranded with no branch
      // pushed. The fabro run reports `succeeded` while the dispatcher
      // reports `failed` at pr-view "no PR found for branch"; that
      // disagreement is what makes this read as an item defect when it is not.
      //
      // ROOT CAUSE. The plugin's model table (`_codex_model_tiers.py`) records
      // that it was measured 2026-08-26 against `@agentclientprotocol/codex-acp`
      // 1.6.2, lists `gpt-5.4-mini` among the slugs that COMPLETED a turn, and
      // states the governing rule: the reachable set is a property OF THE BAKED
      // ADAPTER VERSION and must be re-measured whenever that version changes.
      // Image `python-agent-v1.63.0` -- the one this repo dispatches on -- bakes
      // codex-acp 1.10.0 (verified by reading package.json inside the image, not
      // inferred from the Dockerfile ARG). The set was never re-measured, and the
      // 400 above is verbatim the refusal signature that table attributes to
      // slugs ABSENT FROM THE CATALOG.
      //
      // NOT THE SAME DEFECT AS THE CONSOLE'S. livespec-console-beads-fabro parks
      // this node for a JSON-quote parse defect that kills the Codex node in
      // startAcpServer BEFORE it does any work. Ours starts fine and reaches the
      // API; only the model is refused. Same remedy, different cause.
      //
      // WHY HERE AND NOT IN workflow.toml. `repository_acp_overlays` builds the
      // codex-shorthand overlays first and then `overlays.update()`s the explicit
      // `acp_nodes` table over them, so THIS key wins. Editing `pr_adapter` in
      // `.fabro/workflows/implement-work-item/workflow.toml` would leave a green
      // tree and an UNCHANGED live adapter.
      //
      // WHY NOT THE DOCUMENTED TIER OPT-OUT. `codex_models.pr.model = ""` removes
      // only the `model` / `model_reasoning_effort` keys inside `CODEX_CONFIG`;
      // the posture keys and the Codex command are emitted regardless, so the node
      // stays on Codex and stays dead.
      //
      // COST NOTE. The `pr` tier exists to keep a scripted git/gh recipe off the
      // expensive implementer tier. This parks it on the same Claude adapter the
      // implementer uses -- a deliberate cost regression taken over a dead publish
      // leg, the same trade livespec-console-beads-fabro and homelab already made.
      // The value is byte-identical to workflow.toml's own `pr_adapter` default.
      //
      // REVERT CONDITION: a re-measured reachable-model table for codex-acp 1.10.0
      // naming a `pr`-tier slug that completes a turn. Tracked on
      // livespec-dev-tooling-zwsl.
      // Codex model prices for the cost report: the published Standard,
      // short-context USD per 1M tokens (developers.openai.com/api/docs/models/,
      // verified 2026-10-19), cache writes at 1.25x input.
      "model_catalog": {
        "openai/gpt-5.6-terra": {
          "display_name": "GPT-5.6 Terra",
          "pricing": {
            "model": "gpt-5.6-terra",
            "input_usd_per_million": 2.0,
            "output_usd_per_million": 12.0,
            "cache_write_usd_per_million": 2.5,
            "cache_read_usd_per_million": 0.2
          }
        },
        "openai/gpt-5.6-luna": {
          "display_name": "GPT-5.6 Luna",
          "pricing": {
            "model": "gpt-5.6-luna",
            "input_usd_per_million": 0.2,
            "output_usd_per_million": 1.2,
            "cache_write_usd_per_million": 0.25,
            "cache_read_usd_per_million": 0.02
          }
        }
      },
      "acp_nodes": {
        "dod_gate": { "agent": "claude-acp", "model": "claude-opus-4-8", "effort": "high", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high" }] },
        "implement": { "agent": "claude-acp", "model": "claude-opus-5", "effort": "high", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high" }] },
        "fix": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-opus-5", "effort": "high" }] },
        "review_fix": { "agent": "claude-acp", "model": "claude-opus-5", "effort": "high", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high" }] },
        "proof_capture": { "agent": "claude-acp", "model": "claude-opus-5", "effort": "high", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high" }] },
        "proof_verify": { "agent": "claude-acp", "model": "claude-opus-4-8", "effort": "high", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high" }] },
        "review": { "agent": "claude-acp", "model": "claude-opus-4-8", "effort": "high", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high" }] },
        "pr": { "agent": "claude-acp", "model": "claude-sonnet-4-6", "effort": "medium", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-luna", "effort": "low" }] },
        "disposition": { "agent": "claude-acp", "model": "claude-sonnet-4-6", "effort": "medium", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-luna", "effort": "low" }] }
      },

      // Per-node ACP turn ceilings (contracts.md "ACP node timeouts", v081).
      // The plugin's built-in default is 1800s for EVERY node; that default is
      // the maintainer's fleet-wide ruling and is NOT relitigated here -- it
      // stays in force for every node absent from this table. This repo had NO
      // override at all, so every node ran at 1800s.
      //
      // WHY THIS REPO NOW OVERRIDES, with the measurement rather than a
      // preference. The dev-tooling-backlog-drain (epic livespec-dev-tooling-
      // kcoslm) stalled its entire gate-heavy keep class on this ceiling: the
      // RGR `implement`/`review_fix` ACP turn executes this repository's full
      // `just check` aggregate (4,172 tests) as a Red->Green pair plus a
      // coverage rerun, and under factory load that turn exceeds 1800s. The
      // failure is systemic, not item-specific -- s1ic, u3f6bw, and cross-actor
      // ozbqmx all died identically in one wave with the "ACP turn timed out"
      // signature at the configured ceiling (the constant, not a slow turn),
      // while master CI was GREEN (the gate itself PASSES; only the sandbox
      // turn was shorter than the aggregate runtime). The not-yet-dispatched
      // keeps go7a/xam/izbq/uw3h would fail identically. This blocks ALL
      // gate-heavy product-.py dispatch for the drain; tmux-worker fallback is
      // disallowed for this repo, so there is no in-session route either.
      // Maintainer direction 2026-10-10 (live in-session resume of kcoslm):
      // raise the ceiling.
      //
      // The values mirror livespec-orchestrator-beads-fabro's own proven
      // table, which fixed the byte-identical failure signature in that repo
      // (its heavier 7,194-test aggregate died the same way at 1800038 ms and
      // was restored to prior working behaviour with exactly these headrooms):
      // implement 14400s, review_fix 7200s, fix/janitor 3600s. A generous turn
      // ceiling only bounds the worst case -- a fast turn returns immediately
      // -- so over-provisioning here is safe; under-provisioning is what caused
      // the stall. Every other node (pr, review, disposition, proof_*, and the
      // terminal handlers) stays at the 1800s default, which it already met.
      // LOWERED 2026-10-19 (coordinator ruling R261: run the factory on the
      // Codex allowance). Every node timeout feeds the Codex credential-lifetime
      // floor, and with proof_capture at 3600 the floor was 902100 s, longer
      // than a fresh ten-day Codex token (864000 s), so no Codex-primary node
      // could be admitted. proof_grade and proof_grade_route take
      // livespec-orchestrator-beads-fabro's proven 600 s, and proof_capture
      // drops 3600 -> 2900 s, the least cut that brings the floor to 839500 s
      // (orchestrator's is 842580 s). Each 300 s of proof_capture moved the
      // floor by 11400 s. This gives back part of the 2026-10-15 proof_capture
      // raise (commit 04df2dc9): watch proof_capture timeouts on these runs.
      "node_timeouts": {
        "implement": 14400,
        "janitor": 3600,
        "fix": 3600,
        "review_fix": 7200,
        "proof_capture": 2900,
        "proof_grade": 600,
        "proof_grade_route": 600
      },

      "wip_cap": 10,
      // ONE registry-backed entry, naming no machine. The Dispatcher resolves
      // `legacy` by name from `/etc/livespec/fabro-factories.json`, which this
      // repository's own `fabro_factory_registry` role renders on every
      // dispatching host from `ansible/inventory/group_vars/dev_hosts.yml` —
      // THE ONE PLACE A FACTORY IS BOUND TO A MACHINE, per
      // SPECIFICATION/non-functional-requirements.md §"Fabro factory registry"
      // ("Machines are bound only in the inventory") and the maintainer's
      // 2026-10-15 ruling on plan `petri-factory-on-gmktec`. A `server` beside
      // `"registry": true` would leave the machine bound here and the registry
      // unread, with routing working either way — which is why this entry
      // carries no address at all.
      //
      // Routing is UNCHANGED by the switch: the registry maps `legacy` to
      // hp-xubuntu's `fabro-server` instance, whose `canonical_host` is
      // `hp-xubuntu.perch-rudd.ts.net:32276` — byte-identical to the address
      // the retired `hp` entry carried. `legacy` names that INSTANCE and not
      // its role, so the name survives a move of the instance between machines.
      //
      // The retired `vps` entry is gone rather than carried forward, and `hp`
      // is not kept as an alias: a recorded item pin naming either falls back
      // to `default_factory` under the ratified recorded-pin fallback, so
      // neither needs an entry to resolve against.
      //
      // `petri` — the gmktec-xubuntu :32276 Petri-era instance, also resolved
      // by name through the registry — is onboarded with the bin and
      // secret-channel settings that work-item livespec-dev-tooling-knd3s7
      // left as a separate decision, mirroring livespec-orchestrator-beads-fabro
      // (bd-ib-iud52v, PR #3461). `bin` pins the Petri-era client the engine
      // needs, which takes precedence over the global `fabro_bin`;
      // `secret_channel: native_secrets` hands credentials through that
      // server's native secrets; and `environment: livespec-ci` selects the
      // server-managed environment that supplies the sandbox image on petri.
      // `default_factory` moved from `legacy` to `petri` under coordinator
      // ruling R668 (2026-10-22), the maintainer-directed Fabro cutover.
      // `legacy` stays declared, so an item already dispatched keeps its
      // recorded pin and in-flight work finishes on hp; rollback is reverting
      // this change.
      //
      // `environment` moved from `livespec-ci` to `livespec-ci-k8s` under
      // coordinator ruling R670's Option C (2026-10-23, recorded on
      // livespec-dev-tooling-dfixhe): the Kubernetes sandbox backend cutover for
      // THIS repository's dispatches only (plan kubernetes-sandbox-backend,
      // bd-ib-nmuyjc.1 in the orchestrator tenant). `livespec-ci-k8s` is
      // livespec-ci's twin on gmktec's server, built by the kubernetes
      // sandbox-driver plugin as a pod on the maintainer-owned cluster (cpu 4,
      // 7629Mi; ansible host_vars, PR #2779). The one-step rollback to Docker is
      // setting it back to `livespec-ci`. The other fleet repositories keep
      // `livespec-ci` until a separate fleet step.
      //
      // Re-applied after the first canary (run 01M5MH0JBKGJ) ended
      // INFRASTRUCTURE-class on an empty sandbox environment: the dispatcher
      // keyed `[environments.<id>.env]` on the workflow's committed id rather
      // than the factory's catalog environment. Orchestrator release 0.239.3
      // (bd-ib-kyeor4, PR #3559) keys it on the factory's environment.
      //
      // Re-applied a third time after the re-canary (run 01M5N2W7TNBC) failed at
      // prepare step 28 with exit_status:-1: the sandbox-driver put each
      // command's argv in the exec URL, which a large inline payload overflowed.
      // sandbox-driver-kubernetes v0.4.1 (bd-ib-xwqn23) stages the command spec
      // over exec stdin; it is deployed to gmktec (livespec-dev-tooling PR #2788)
      // and loaded by the production fabro-server before this flip merges.
      "default_factory": "petri",
      "factories": {
        // legacy submits through the pinned 0.254 8869e88 client whose bytes match hp's
        // declared engine, staged by the livespec-dev-tooling dev-host play (bd-ib-zb2hso).
        "legacy": {
          "registry": true,
          "bin": "/home/ubuntu/.local/state/fabro-currency/carrier-legacy-v0.254-8869e88/fabro"
        },
        "petri": {
          "registry": true,
          "bin": "/home/ubuntu/.local/state/fabro-currency/carrier-petri-v0.382-adeefec4c/fabro",
          "secret_channel": "native_secrets",
          "environment": "livespec-ci-k8s"
        }
      }
    }
  }
}
