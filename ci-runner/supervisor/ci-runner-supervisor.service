# ci-runner-supervisor.service — the ephemeral-runner supervisor.
# Runs as ci-sup, the ONLY account that reads the App private key. The key + config
# come from the dedicated `github-ci-runners` 1Password environment, injected ONLY
# into this service via its own wrapper — never into the shared livespec environment
# and never into ci-runner or job containers. The supervisor mints JIT configs and
# starts runner@*.service via the narrow polkit rule (49-ci-runner-supervisor.rules).
[Unit]
Description=CI runner supervisor (ephemeral JIT runner pool)
After=network-online.target user@1001.service
Wants=network-online.target

[Service]
Type=simple
User=ci-sup
Group=ci-sup
# The 1Password CLI needs a writable HOME of its own. (The wrapper re-derives HOME
# for the invoker anyway; this is belt-and-braces for the pre-wrapper stage.)
Environment=HOME=/var/lib/ci-sup
# ci-sup is a supplementary member of ci-runner only if a shared read is needed;
# the JIT handoff uses LoadCredential (root), so no group sharing is required.
# /run/ci-runner is this unit's private runtime dir (0700 ci-sup); root (the runner
# unit's LoadCredential) can still read the staged JIT files.
RuntimeDirectory=ci-runner
RuntimeDirectoryMode=0700
#
# CONFIG IS PASSED AS ARGUMENTS, NEVER AS Environment= — load-bearing.
# The App key + secrets come from the github-ci-runners 1Password environment via
# the wrapper below, and that wrapper SCRUBS the environment (`env -i`). So any
# `Environment=CI_RUNNER_*` set here would be silently DISCARDED before the script
# ever sees it. This unit used to carry exactly such lines, and every one of them
# was being thrown away (2026-07-14): the repo/label values happened to match the
# script's own defaults so nothing looked wrong, but the slot count did not — the
# pool sat at ONE runner while this file claimed 18. Arguments survive the scrub.
#
# --slots 18 (one per core): livespec's CI is a per-target MATRIX (~60 jobs) and each
# ephemeral runner takes exactly ONE job, so the slot count IS the CI parallelism —
# at 1 slot the whole matrix serializes through a single runner. The matrix is
# deliberately KEPT (free per-check failure isolation, individual PR status checks,
# granular required-checks); the concurrency knob is the slot count, NOT collapsing
# the matrix. The full matrix is only ~591 CPU-seconds/run, so 18 cores match
# GitHub's wall-clock. See livespec plan/fabro-ci-image-factoring/handoff.md
# §"Additional research".
ExecStart=/usr/local/bin/with-github-ci-runners-env.sh -- /usr/local/lib/ci-runner/ci-runner-supervisor.sh --repos thewoolleyman/livespec --slots 18 --labels self-hosted,local-ci
Restart=always
RestartSec=10
# Slot preflight exits 75 when the local canonical install or a stable runner
# root is invalid. Retrying that breach would only repeat local filesystem work;
# it must remain visibly failed until an operator repairs the host. Crucially the
# supervisor has not made a GitHub request at that point.
RestartPreventExitStatus=75
# Hardening — the supervisor holds the most powerful secret, so lock down what can
# be locked down. NoNewPrivileges is deliberately NOT set: the 1Password wrapper
# self-escalates via `sudo -n` to systemd-creds-decrypt its service-account token,
# and that flag blocks the escalation ("sudo: The 'no new privileges' flag is set")
# so the unit never starts. This file previously carried NoNewPrivileges=true plus a
# kernel/namespace hardening block that the live host does not run; the drift was
# caught (2026-07-14) when the gate lane reused this unit as its template and the
# copy failed to boot. This is now what actually runs.
ProtectSystem=strict
ReadWritePaths=/run/ci-runner /var/lib/ci-sup
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
