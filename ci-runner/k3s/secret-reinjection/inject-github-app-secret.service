# inject-github-app-secret.service — boot-time (re)injection of the k8s
# Secret arc-runners/arc-github-app-installation from 1Password.
#
# WHY THIS EXISTS: the GitHub App credential ARC needs lives ONLY in the k3s
# datastore and was created BY HAND. A datastore wipe (the coming tmpfs
# cutover, sibling item livespec-mx26zz) or any fresh cluster loses it until
# an operator hand-recreates it, and install-arc.sh fails closed without it.
# This oneshot reconstructs it from 1Password at every boot, with no manual
# step, BEFORE the reconstruct converge runs ARC. See
# inject-github-app-secret.sh's header for the full rationale and the
# secret-handling discipline.
#
# IDENTITY: runs as ci-sup — the SAME least-privilege identity that reads the
# App private key for the podman pool's gate supervisor (see
# ../../gate-runner/gate-runner-supervisor.service). No new identity gains
# the App key. The github-ci-runners 1Password wrapper self-escalates via
# `sudo -n` to systemd-creds-decrypt its service-account token, then drops
# back to ci-sup — so NoNewPrivileges is deliberately NOT set (it would block
# that escalation and the unit would never start), exactly as in
# gate-runner-supervisor.service.
#
# KUBECONFIG PRECONDITION: ci-sup MUST be able to read the k3s kubeconfig
# named below (an attended-cutover step — grant read access or point
# KUBECONFIG at a copy readable by ci-sup). See ../README.md
# "Credential separation".
[Unit]
Description=Reinject the arc-runners/arc-github-app-installation secret from 1Password at boot
# ARC's credential must exist before k3s serves ARC, and the API must be up
# for kubectl. network-online is needed for the 1Password `op run` call.
After=k3s.service network-online.target
Requires=k3s.service
Wants=network-online.target
# Run BEFORE the reconstruct-on-boot converge that brings ARC up, so the
# secret is present when the converge applies install-arc.sh. converge-ci-stack.service
# is the sibling olp4c5 unit, authored in the sibling PR
# feat/ci-host-reconstruct-on-boot; the ordering is one-directional and
# harmless if that unit is absent.
Before=converge-ci-stack.service

[Service]
Type=oneshot
User=ci-sup
Group=ci-sup
# The 1Password CLI needs a writable HOME of its own (matches
# gate-runner-supervisor.service).
Environment=HOME=/var/lib/ci-sup
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
# Run the injector UNDER the dedicated github-ci-runners 1Password wrapper,
# which injects GITHUB_APP_ID_CI_RUNNER / GITHUB_APP_INSTALLATION_ID_CI_RUNNER
# / GITHUB_PRIVATE_KEY_CI_RUNNER into the script's environment (never argv).
ExecStart=/usr/local/bin/with-github-ci-runners-env.sh -- /usr/local/lib/ci-runner-k3s/inject-github-app-secret.sh

[Install]
WantedBy=multi-user.target
