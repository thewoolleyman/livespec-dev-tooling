# inject-github-app-secret.service — boot-time (re)injection of the k8s
# Secret arc-runners/arc-github-app-installation from the host's local
# systemd credstore.
#
# WHY THIS EXISTS: the GitHub App credential ARC needs lives ONLY in the k3s
# datastore and was created BY HAND. A datastore wipe (the coming tmpfs
# cutover, sibling item livespec-mx26zz) or any fresh cluster loses it until
# an operator hand-recreates it, and install-arc.sh fails closed without it.
# This oneshot reconstructs it at every boot, with no manual step, BEFORE
# the reconstruct converge runs ARC. See inject-github-app-secret.sh's
# header for the full rationale and the secret-handling discipline.
#
# CREDENTIAL MODEL — host-encrypted local credstore, decrypted as ROOT at
# boot. The three App values are stored host-encrypted under
# /etc/credstore.encrypted/ (seeded once, attended, by the maintainer via
# seed-github-app-creds.sh — the only step that touches 1Password). The
# LoadCredentialEncrypted= lines below decrypt them into $CREDENTIALS_DIRECTORY
# (root-only) at start — NO `op run`, NO 1Password wrapper, NO ci-sup, NO
# network. This replaced an earlier op-run/wrapper model that could not work
# unattended on this host: `op run` refuses to run as root, no ci-sup
# identity exists, and the gate-runner era that used that wrapper is
# decommissioned. systemd-creds is already used on this host (for its own
# service-account token), so the facility is confirmed available.
[Unit]
Description=Reinject the arc-runners/arc-github-app-installation secret from the local credstore at boot
# ARC's credential must exist before k3s serves ARC, and the API must be up
# for kubectl. No network dependency — decryption is fully local.
After=k3s.service
Requires=k3s.service
# Run BEFORE the reconstruct-on-boot converge that brings ARC up, so the
# secret is present when the converge applies install-arc.sh.
# converge-ci-stack.service is the sibling livespec-olp4c5 unit, authored in
# the sibling PR feat/ci-host-reconstruct-on-boot; the ordering is
# one-directional and harmless if that unit is absent.
Before=converge-ci-stack.service

[Service]
Type=oneshot
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
# Decrypt the three host-encrypted App credentials into $CREDENTIALS_DIRECTORY
# (root-only, mode 0400) at start. The credential NAME (left of the colon)
# is what systemd-creds encrypt --name= bound at seed time and is the
# filename the script reads; the path (right of the colon) is the
# host-encrypted source under /etc/credstore.encrypted/.
LoadCredentialEncrypted=arc-github-app-id:/etc/credstore.encrypted/arc-github-app-id
LoadCredentialEncrypted=arc-github-app-installation-id:/etc/credstore.encrypted/arc-github-app-installation-id
LoadCredentialEncrypted=arc-github-app-private-key:/etc/credstore.encrypted/arc-github-app-private-key
ExecStart=/usr/local/lib/ci-runner-k3s/inject-github-app-secret.sh

[Install]
WantedBy=multi-user.target
