# inject-gate-forge-secret.service — boot-time (re)injection of the k8s
# Secret gates/gate-forge-credential from the host's local systemd credstore.
#
# WHY THIS EXISTS: the delegated pre-push gate's two forge-credential-reading
# targets (check-branch-protection-alignment, check-master-ci-green) fail
# CLOSED inside a gate pod without this Secret, so a delegated gate run goes
# red without it. The k3s datastore is on tmpfs (../phase2/datastore-tmpfs/),
# so every reboot wipes the Secret, and it is deliberately NOT applied by
# converge (an empty Secret is worse than an absent one — see
# ../phase2/gates/gate-credentials.yaml). Until this unit the Secret was
# created BY HAND once per cluster rebuild, and a reboot silently broke the
# gate until an operator noticed. This oneshot reconstructs it at every boot
# with no manual step. See inject-gate-forge-secret.sh's header for the full
# rationale and the secret-handling discipline. (plan livespec
# k3s-on-gmktec-for-vps-usage, epic livespec-sab5gn.)
#
# CREDENTIAL MODEL — host-encrypted local credstore, decrypted as ROOT at
# boot, mirroring the sibling inject-github-app-secret.service exactly. The
# token is stored host-encrypted at /etc/credstore.encrypted/gate-forge-token
# (seeded once, attended, via seed-gate-forge-cred.sh — the only step that
# touches 1Password). The LoadCredentialEncrypted= line below decrypts it into
# $CREDENTIALS_DIRECTORY (root-only) at start — NO `op run`, NO 1Password
# wrapper, NO network. systemd-creds is already used on this host, so the
# facility is confirmed available.
[Unit]
Description=Reinject the gates/gate-forge-credential secret from the local credstore at boot
# The gate credential must exist before any delegated gate pod runs, and the
# API must be up for kubectl. No network dependency — decryption is fully
# local. Unlike the ARC App secret, no converge step consumes this one (gate
# Jobs are submitted ad hoc by the gate-remote client), so no Before= a
# converge unit is needed — running at boot after k3s suffices.
After=k3s.service
Requires=k3s.service

[Service]
Type=oneshot
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
# Decrypt the host-encrypted token into $CREDENTIALS_DIRECTORY (root-only,
# mode 0400) at start. The credential NAME (left of the colon) is what
# systemd-creds encrypt --name= bound at seed time and is the filename the
# script reads; the path (right of the colon) is the host-encrypted source
# under /etc/credstore.encrypted/.
LoadCredentialEncrypted=gate-forge-token:/etc/credstore.encrypted/gate-forge-token
ExecStart=/usr/local/lib/ci-runner-k3s/inject-gate-forge-secret.sh

[Install]
WantedBy=multi-user.target
