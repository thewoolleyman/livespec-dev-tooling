# converge-ci-stack.service — boot-ordered reconstruct of the CI CLUSTER
# stack on the single-node k3s host. Runs converge-ci-stack.sh once per boot,
# AFTER k3s is up, to idempotently converge the ARC controller, all runner
# scale sets, the hook-pod-template ConfigMap, Kueue core, and every
# ResourceFlavor/ClusterQueue/LocalQueue from this repository — zero manual
# kubectl/helm steps. See ./converge-ci-stack.sh for the full sequence, the
# scope boundary (cluster stack only, not the node-local machinery), and the
# fail-closed GitHub-App-secret pre-gate.
#
# ORDERING vs. the secret: converge fail-closes if the arc-github-app-installation
# secret is absent (the script's step 2). A sibling work-item (livespec-qqzlek)
# adds a unit that re-injects that secret on boot; once it exists, add an
# `After=<that-unit>` line below so the secret is present before this converges.
# Until then the script's own fail-closed gate is the ordering guarantee.
#
# oneshot (not a long-running service): it converges and exits. It is NOT
# RemainAfterExit — a converged cluster needs no held state, and leaving it
# inactive-dead after a clean exit is correct. Re-run manually any time with
# `systemctl start converge-ci-stack.service` (idempotent).
[Unit]
Description=Converge the CI cluster stack (ARC + scale sets + Kueue + queues) on the k3s host
After=k3s.service
Requires=k3s.service

[Service]
Type=oneshot
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
ExecStart=/usr/local/lib/ci-runner-k3s/converge-ci-stack.sh

[Install]
WantedBy=multi-user.target
