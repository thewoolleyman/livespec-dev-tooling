# Publish this node's gate-placement readings as its LivespecGateLaneCPU
# condition (publish-gate-lane-readings.sh). Installed by the
# gate_placement_publisher Ansible role on EVERY ci_pool node; the placeholders
# are rendered from the node's profile.
[Unit]
Description=Publish this node's gate-placement readings as its LivespecGateLaneCPU condition
After=K3S_UNIT_PLACEHOLDER

[Service]
Type=oneshot
ExecStart=/usr/local/lib/ci-runner-k3s/publish-gate-lane-readings.sh PROFILE_PATH_PLACEHOLDER
