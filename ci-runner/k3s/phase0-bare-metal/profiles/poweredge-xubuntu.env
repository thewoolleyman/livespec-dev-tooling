# poweredge-xubuntu.env — the per-node DATA the bare-metal rebuild procedure
# consumes for the fleet's first pool node.
#
# THIS FILE CARRIES NO PROCEDURE. It is read by ../storage-layout.sh (stage 1)
# and, as the later bare-metal stages land, by the base-OS install and by the
# arguments handed to ../../provision-k3s.sh and ../../phase2/install-node.sh.
# A second pool node is a SECOND FILE in this directory consumed by the SAME
# scripts — never a second script and never a hand-edited copy of one
# (SPECIFICATION/non-functional-requirements.md §"Runner-pool node rebuild
# recipe", "One profile per node").
#
# FORMAT (identical for every node's profile, so one parser reads them all):
#   * `KEY=value`, one per line. `#` comments and blank lines are ignored.
#   * No quoting, no `$` expansion, no shell: the file is PARSED, not sourced.
#   * Every key below is REQUIRED to be present. A key may be EMPTY only where
#     its own comment says so.
#   * A list-valued key holds SPACE-separated records; a record's fields are
#     separated by `:`.
#
# PROVENANCE of the values below, so a rebuild knows what is measured and what
# is not. The node's hardware facts live in the per-host information repository
# `poweredge-xubuntu-info` (`AGENTS.md` §Storage), NOT here — this file carries
# only the values the procedure consumes.
#   RECORDED IN THIS REPOSITORY, and therefore trustworthy as written:
#     - every volume group and its physical volume, every logical volume's size,
#       and every role tier's placement. These are transcribed from the host
#       record into `poweredge-xubuntu.recorded-facts` beside this file, and
#       `../storage-layout-exit-tests.sh` §E fails if this profile and that
#       table disagree about any of them in either direction. Read that file for
#       the values and their provenance rather than trusting a re-reading of
#       this one; note in particular that there are TWO NVMe volume groups —
#       `nvmea` carries `ci-containerd`, `nvmeb` carries `ci-workvols` — and
#       that this profile declared only `nvmea`, with `swap` at 64 GiB, until
#       the 2026-09-06 read corrected both (livespec-dev-tooling-nzhceg);
#     - the target device, and that `ci-cache` sits on the array's volume group
#       while the two NVMe drives carry the other two tiers, one each, since the
#       2026-09-04 17:07Z cutover (`../../phase2/README.md` §"Where the tiers
#       live now");
#     - that an NVMe physical volume is addressed by its `/dev/disk/by-id/`
#       serial path and no other form
#       (`../../phase2/storage-layout/migrate-tier.sh` rejects any other);
#     - each role's filesystem type, which MUST agree with `migrate-tier.sh`
#       `role_fstype` and with `install-storage-layout.sh`'s fstab lines:
#       `ci-cache` and `ci-containerd` ext4, `ci-workvols` XFS with reflink;
#     - the admission capacity C = 32 since 2026-09-06
#       (`../../README.md`, `../../phase2/kueue/DERIVATION.md`);
#     - that this node pins neither a node IP nor a flannel interface:
#       `../../provision-k3s.sh` passes no `--node-ip` and no `--flannel-iface`,
#       so k3s binds `0.0.0.0` and follows the default route (hence `auto`).
#     - the operating system the fleet hosts run, Ubuntu 26.04 "resolute", and
#       that the 2026-09-04 hand rebuild needed `lvm2` INSIDE the chroot before
#       the initramfs was regenerated or the root volume group would not
#       activate at boot (the "lvm2-in-chroot plus dracut bootability fix"
#       recorded in the livespec-g52yrb ledger handoffs of 2026-09-04) — which
#       is why INITRAMFS_GENERATOR below names dracut;
#     - the firmware boot path the rebuild ended at: an ESP entry chaining a
#       signed shim to GRUB to `root=/dev/mapper/poweredge-root`
#       (`poweredge-xubuntu-info` `AGENTS.md` §Storage, quoted in this
#       repository's ledger item for the base-OS stage).
#   NOT RECORDED IN THIS REPOSITORY — CONFIRM against `poweredge-xubuntu-info`
#   `AGENTS.md` §Storage before the first rebuild rehearsal, and correct here if
#   it disagrees. These are marked `# UNVERIFIED` on their own lines:
#     - the storage controller's CLI path and controller id;
#     - the firmware boot entry's label and the operator account's name.
#   Nothing here is destroyed without `--i-consent-to-destroy` naming the exact
#   target, so a wrong value refuses rather than acting — but the rehearsal
#   obligation of the specification section above is what actually closes this.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
NODE_NAME=poweredge-xubuntu

# ---------------------------------------------------------------------------
# Storage controller and its virtual disk
#
# A node with no storage controller sets CONTROLLER_KIND=none and leaves
# CONTROLLER_CLI, CONTROLLER_ID and every VD_* value EMPTY; the procedure then
# skips the virtual-disk stage entirely and partitions TARGET_DEVICE directly.
# ---------------------------------------------------------------------------
CONTROLLER_KIND=perccli
# PERC H730P Mini. UNVERIFIED: perccli's documented install path.
CONTROLLER_CLI=/opt/MegaRAID/perccli/perccli64
# UNVERIFIED: the single H730P is expected to enumerate as controller 0.
CONTROLLER_ID=0
# `auto` = read the enclosure id off the controller at run time rather than
# pinning a number this repository has not measured. This node's backplane
# enumerates as enclosure 32; `../storage-layout-exit-tests.sh` case B5 drives
# the resolver with that enclosure table and asserts it plans `drives=32:0-6`,
# which is what makes `auto` admissible here instead of a pinned literal.
VD_ENCLOSURE=auto
# The seven array drives, in perccli slot syntax.
VD_SLOTS=0-6
VD_RAID_LEVEL=5
VD_STRIP_KIB=64
# WriteBack + Read Ahead + Direct IO ("RWBD" as the controller reports it).
VD_CACHE_POLICY=wb,ra,direct

# ---------------------------------------------------------------------------
# Partition table on the device the virtual disk presents as
#
# The procedure's fixed structure is partition 1 = EFI system partition,
# partition 2 = the LVM physical volume; this profile names the devices those
# partitions appear at, so a node whose device numbers partitions differently
# (an NVMe `...p1`) states its own paths here.
# ---------------------------------------------------------------------------
TARGET_DEVICE=/dev/sda
ESP_DEVICE=/dev/sda1
ESP_SIZE=1GiB
ESP_FSTYPE=vfat
ESP_LABEL=ESP
PV_PARTLABEL=lvm

# ---------------------------------------------------------------------------
# Volume groups — one per medium. Records are `<vg>:<physical-volume-device>`.
#
# An NVMe physical volume is addressed by `/dev/disk/by-id/` ONLY: behind a
# PCIe switch the `nvme0n1` ordering can shift across boots
# (`.ai/ci-node-storage-tiers.md`, and `migrate-tier.sh` rejects any other
# form) — which is exactly why the two NVMe groups below are told apart by
# SERIAL and never by `nvme0n1`/`nvme1n1`. On the 2026-09-06 read `nvmea` was
# `nvme1n1` and `nvmeb` was `nvme0n1`; neither number belongs in this file.
# ---------------------------------------------------------------------------
VOLUME_GROUPS=poweredge:/dev/sda2 nvmea:/dev/disk/by-id/nvme-WD_BLACK_SN8100_4000GB_25384T801085 nvmeb:/dev/disk/by-id/nvme-WD_BLACK_SN8100_4000GB_25374X802154

# ---------------------------------------------------------------------------
# Logical volumes — records are `<vg>:<lv>:<size>:<fstype>:<label>`.
#
# Sizes are binary (GiB/TiB). The role LVs deliberately carry the SAME name on
# every medium, which is what makes a tier's identity its LABEL rather than its
# device: see `install-storage-layout.sh`'s header and
# `../../phase2/README.md` §"Why labels, and the 16-byte rule".
# Every size, filesystem and label below is asserted against
# `poweredge-xubuntu.recorded-facts` — change one there first, or not at all.
# ---------------------------------------------------------------------------
LOGICAL_VOLUMES=poweredge:root:200GiB:ext4:root poweredge:swap:8GiB:swap:swap poweredge:ci-cache:1TiB:ext4:ci-cache nvmea:ci-containerd:1.5TiB:ext4:ci-containerd nvmeb:ci-workvols:1.5TiB:xfs:ci-workvols

# ---------------------------------------------------------------------------
# Role-labelled storage tiers — records are `<role-label>:<vg>`.
#
# These are the three labels `../../phase2/storage-layout/install-storage-layout.sh`
# resolves to exactly one block device each, and refuses to run without. Every
# role named here MUST have a logical volume above carrying that label in that
# volume group; the procedure checks it.
# ---------------------------------------------------------------------------
ROLE_TIERS=ci-cache:poweredge ci-containerd:nvmea ci-workvols:nvmeb

# ---------------------------------------------------------------------------
# Base operating system — consumed by ../base-os-install.sh (stage 2).
#
# OS_RELEASE is the SUITE name debootstrap is given and the codename the stage
# compares `/etc/os-release`'s VERSION_CODENAME against when deciding whether a
# root volume already carries this release and must be left alone.
#
# ROOT_LABEL and SWAP_LABEL name LOGICAL_VOLUMES entries above rather than
# repeating a device: the stage resolves each to its volume group and logical
# volume, so the fstab it writes and the `root=` the bootloader gets stay in
# lockstep with the volumes stage 1 actually created. SWAP_LABEL may be EMPTY
# on a node with no swap volume.
#
# INITRAMFS_GENERATOR decides how LVM support reaches the initramfs, which is
# the step whose absence made the 2026-09-04 hand rebuild unbootable:
# `dracut` regenerates with `--add lvm`, `initramfs-tools` with
# `update-initramfs`. Either way `lvm2` is installed in the chroot FIRST.
# ---------------------------------------------------------------------------
OS_DISTRIBUTION=ubuntu
OS_RELEASE=resolute
OS_ARCHITECTURE=amd64
OS_MIRROR=http://archive.ubuntu.com/ubuntu
OS_SECURITY_MIRROR=http://security.ubuntu.com/ubuntu
OS_COMPONENTS=main restricted universe multiverse
KERNEL_PACKAGE=linux-image-generic
INITRAMFS_GENERATOR=dracut
ROOT_LABEL=root
SWAP_LABEL=swap
# UNVERIFIED: the label of the firmware boot entry the 2026-09-04 rebuild left
# at Boot0006. `ubuntu` is the distribution's own conventional entry name.
BOOT_ENTRY_LABEL=ubuntu
# UNVERIFIED: the name of the sudo-capable admin account ../../provision-k3s.sh
# and ../../phase2/install-node.sh are run as. The stage creates the account and
# its groups; it deliberately installs NO credential for it — this tree carries
# no secret, so authorizing a login is the operator's step at the console.
OPERATOR_ACCOUNT=ci-admin
OPERATOR_GROUPS=sudo

# ---------------------------------------------------------------------------
# Network — consumed by the base-OS stage, not by the storage layout.
#
# `auto` means the node pins nothing: k3s binds 0.0.0.0 and follows the default
# route. A node that DOES pin them names its interface and its CIDR here.
# ---------------------------------------------------------------------------
NODE_NETWORK_INTERFACE=auto
NODE_ADDRESS=auto

# ---------------------------------------------------------------------------
# Cluster — consumed by ../../provision-k3s.sh and ../../phase2/install-node.sh.
#
# CLUSTER_JOIN_ADDRESS is EMPTY for a `server` that forms its own cluster; an
# `agent`, or a second server, names the address of the cluster it joins.
# CLUSTER_ROLE also SELECTS the step plan `../../phase2/install-node.sh` runs:
# a `server` runs the whole ordered runbook, an `agent` runs its node-local
# subset and skips the cluster-side and datastore steps.
# ADMISSION_CAPACITY_C is the churn-slot capacity `install-node.sh` READS from
# this file (it takes no capacity argument) and the value the ten ClusterQueue
# quotas sum to.
# ---------------------------------------------------------------------------
CLUSTER_ROLE=server
CLUSTER_JOIN_ADDRESS=
ADMISSION_CAPACITY_C=32
