# ci-runner-cache-prune.service — one storage-hygiene pass (see the .timer).
# Part of the 3lev.1 resource-health work (livespec
# plan/fabro-ci-image-factoring). Runs as ci-runner with the same
# XDG_RUNTIME_DIR the runner@.service units use, so it prunes the SAME
# rootless podman storage the CI jobs fill. Source of truth:
# livespec-dev-tooling ci-runner/observability/ — install via
# install-observability.sh, never hand-edit the live copy.
[Unit]
Description=CI runner rootless-podman cache prune (age-aware)
After=user@1001.service

[Service]
Type=oneshot
User=ci-runner
Group=ci-runner
Environment=XDG_RUNTIME_DIR=/run/user/1001
ExecStart=/usr/local/lib/ci-runner/ci-runner-cache-prune.sh
