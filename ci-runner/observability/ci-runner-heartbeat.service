# ci-runner-heartbeat.service — one liveness gauge emission (see the .timer).
# Originally the 3lev.1 resource-health work (livespec
# plan/fabro-ci-image-factoring); re-pointed at the k3s/ARC host by
# livespec-s43svm.20. Receiver: the CI-runner-host otel-collector
# (thewoolleyman/otel-collector config.ci-runner-host.yaml) on
# 127.0.0.1:4319, exporting to the `livespec` Honeycomb env. Paired triggers
# (both filtered to this host.name): the DEAD-MAN fires on 20 minutes of
# heartbeat SILENCE; the value trigger fires when
# livespec.ci_listeners.active stays < 1.
# Source of truth: livespec-dev-tooling ci-runner/observability/ — install
# via install-observability.sh, never hand-edit the live copy (the s2t
# recreatability rule).
[Unit]
Description=CI runner fleet liveness heartbeat (OTLP gauge to local collector)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Unprivileged and credential-free: systemctl status reads + loopback curl.
DynamicUser=yes
ExecStart=/usr/local/lib/ci-runner/ci-runner-heartbeat.sh
