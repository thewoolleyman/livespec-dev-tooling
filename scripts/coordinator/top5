COORDINATOR_EPIC = "livespec-dev-tooling-6tgd2z"
BACKFILL_TIMEOUT_S = 120
BACKFILL_OVERDUE_EXIT = 3
ALARM_MARK = "SEAT-WATCHDOG-ALARM"
ALARM_COUNT = 3
ALARM_CHARS = 200
PRIORITY_DESC_CHARS = 110
PREFIX = "livespec-dev-tooling-"
FULL_ID = re.compile(r"\b((?:livespec-dev-tooling|overseer|bd-ib|hxi)-[a-z0-9]{5,7})\b")
SHORT_ID = re.compile(r"\(([a-z0-9]{6})\)")
ENTRY_START = re.compile(r"(?:^|[;,]\s+|\bthen\s+|:\s+)(\d+[ab]?)\s+(?=[A-Za-z])", re.M)
