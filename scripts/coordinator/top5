def priority_section(text):
    """The lines of a scope event's `PRIORITIES now` block, joined by newlines, or None."""
    lines = text.splitlines()
    for i, ln in enumerate(lines):
        pos = ln.find("PRIORITIES now")
        if pos < 0:
            continue
        indent = len(ln) - len(ln.lstrip())
        inline = re.match(r"PRIORITIES now:\s*(.*)", ln[pos:])
        block = [inline.group(1)] if inline and inline.group(1) else []
        for nxt in lines[i + 1:]:
            stripped = nxt.strip()
            if not stripped or stripped.startswith("KEPT") or (len(nxt) - len(nxt.lstrip())) <= indent:
                break
            block.append(stripped)
        return "\n".join(block)
    return None


def entry_epic(text, names):
    """The work-item id a priorities entry names, by full id, short id, bare id word or known plan name."""
    found = FULL_ID.search(text)
    if found:
        return found.group(1)
    short = SHORT_ID.search(text)
    if short:
        return PREFIX + short.group(1)
    word = text.strip(",;:() ")
    if re.fullmatch(r"[a-z0-9]{6}", word):
        return PREFIX + word
    first = text.split(None, 1)[0].strip(",;:()") if text.split() else ""
    word = first
    return names.get(word) or plan_epic(word)


def plan_epic(slug):
    """The epic id a plan slug carries in plan/<slug>/associated_work_item_id, or None."""
    if not re.fullmatch(r"[a-z][a-z0-9-]{3,}", slug):
        return None
    path = os.path.join(WORKSPACE, "livespec-dev-tooling", "plan", slug, "associated_work_item_id")
    try:
        found = FULL_ID.search(open(path, encoding="utf-8").read())
    except OSError:
        return None
    return found.group(1) if found else None


def parse_entries(section, names):
    """[(label number, description, epic or None)] in the order a priorities block lists them."""
    marks = list(ENTRY_START.finditer(section))
    out = []
    for idx, mark in enumerate(marks):
        end = marks[idx + 1].start() if idx + 1 < len(marks) else len(section)
        body = " ".join(section[mark.end():end].split()).rstrip(";, ")
        body = re.sub(r",? and the rest unchanged\.?$", "", body).rstrip(".;, ")
        out.append((mark.group(1), body, entry_epic(body, names)))
    return out


def parse_priorities(comments):
    """(entries, record timestamp) from the newest priorities-record scope event, or (None, reason).

    A record that says the rest is unchanged chains to the next older record; an entry the
    newer record already names (by work item id) keeps its newer rank and wording.
    """
    names = dict(NAME_ID.findall("\n".join(c.get("text") or "" for c in comments)))
    records = [
        (c.get("created_at") or "", priority_section(c.get("text") or ""), c.get("text") or "")
        for c in comments
        if (c.get("text") or "").startswith("plan-scope-event")
    ]
    records = [r for r in records if r[1] is not None]
    if not records:
        return None, "no scope event with a PRIORITIES now block"
    records.sort(key=lambda r: r[0])
    merged, seen = [], set()
    for stamp, section, full in reversed(records):
        got = parse_entries(section, names)
        if not got:
            return None, f"the {stamp} record has a PRIORITIES now block with no numbered entries"
        for label, body, epic in got:
            if (epic is not None and epic in seen) or (epic is None and merged and stamp != records[-1][0]):
                continue
            if epic is not None:
                seen.add(epic)
            merged.append((label, body, epic))
        if not UNCHANGED.search(full):
            break
    return merged, records[-1][0]


def label_key(label):
    digits = re.match(r"\d+", label)
    return (int(digits.group(0)) if digits else 0, label)


def priorities_list(comments):
    """The (label, description, epic) rows the P-list prints, newest record first, or a fallback TOP with a reason."""
    if comments is None:
        return [(lab.split(" ", 1)[0], lab.split(" ", 1)[1], epic) for lab, epic in TOP], "UNREAD priorities-record: ledger read failed"
    rows, info = parse_priorities(comments)
    if rows is None:
        fallback = [(lab.split(" ", 1)[0], lab.split(" ", 1)[1], epic) for lab, epic in TOP]
        return fallback, f"UNREAD priorities-record: {info}"
    rows.sort(key=lambda r: label_key(r[0]))
    return rows, f"priorities-record {info} (newest PRIORITIES now scope event on {COORDINATOR_EPIC})"


