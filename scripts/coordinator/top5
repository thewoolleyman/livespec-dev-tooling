UTC_NOW = NOW.strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_args():
    parser = argparse.ArgumentParser(prog="top5", description="Priority-first coordinator tick header.")
    parser.add_argument("--seat", default="legacy-coordinator-agent", choices=sorted(SEATS))
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--ack", action="store_true", help="record the displayed rules state and exit 0")
    mode.add_argument("--rules-only", action="store_true", help="print only the RULES-CHANGED section")
    return parser.parse_args(sys.argv[1:])


def git(*args, timeout=60):
    """(exit code, stdout, stderr) of one git command in the livespec-dev-tooling checkout."""
    try:
        proc = subprocess.run(["git", "-C", RULES_REPO, *args], capture_output=True, text=True, timeout=timeout)
    except Exception as exc:
        return 1, "", str(exc)
    return proc.returncode, proc.stdout, proc.stderr


def rules_ref(warnings):
    """Fetch origin/master quietly; on failure keep the local ref and say so."""
    code, _, err = git("fetch", "--quiet", "origin", "master", timeout=90)
    if code != 0:
        last = (err.strip().splitlines() or [f"exit {code}"])[-1]
        warnings.append(f"WARNING: git fetch failed ({last[:160]}); comparing against the local {RULES_REF} ref")
    if git("rev-parse", "--verify", "--quiet", RULES_REF + "^{commit}")[0] != 0:
        warnings.append(f"WARNING: no {RULES_REF} ref in {RULES_REPO}; comparing against HEAD")
        return "HEAD"
    return RULES_REF


def blob_at(ref, path):
    code, out, _ = git("rev-parse", "--verify", "--quiet", f"{ref}:{path}")
    return out.strip() if code == 0 and out.strip() else None


def short(sha):
    return sha[:12] if sha else "absent"


def blob_diff(label, path, old, new):
    """(lines, hint) for one watched file's change since the ack; ([], None) when unchanged."""
    if old == new:
        return [], None
    head = f"{label} {path} {short(old)}..{short(new)}"
    if new is None:
        return [f"{head}: the file is gone at {RULES_REF}"], None
    if old is not None and git("cat-file", "-e", old)[0] != 0:
        return [f"{head}: the acknowledged copy is not in this clone; read the whole file"], None
    if old is None:
        body = ["+" + ln for ln in git("cat-file", "-p", new)[1].splitlines()]
        hint = f"git -C {RULES_REPO} cat-file -p {short(new)}"
    else:
        out = git("diff", "--no-color", "--unified=1", old, new)[1].splitlines()
        hunk = next((i for i, ln in enumerate(out) if ln.startswith("@@")), len(out))
        body = out[hunk:]
        hint = f"git -C {RULES_REPO} diff {short(old)} {short(new)}"
    return [f"{head} (read in full: {hint})"] + ["  " + ln for ln in body], hint


def parse_ts(stamp):
    try:
        return dt.datetime.fromisoformat((stamp or "").replace("Z", "+00:00"))
    except ValueError:
        return None


def is_rule_comment(text):
    """A comment that starts with, or whose first line contains, a rule keyword (case-sensitive)."""
    first = (text or "").lstrip().split("\n", 1)[0]
    return any(word in first for word in RULE_KEYWORDS)


def read_comments(epic):
    """Every comment on one epic, oldest first, or None when the ledger read failed."""
    cwd, wrapper = repo_for(epic)
    data = run(["bd", "comments", epic, "--json"], cwd, wrapper)
    if not isinstance(data, list):
        return None
    return sorted(data, key=lambda c: parse_ts(c.get("created_at")) or NOW)


def comment_lines(epic, comments, since):
    """(lines, hint) for the epic's rule comments created after `since`."""
    cut = parse_ts(since)
    fresh = [
        c for c in comments
        if is_rule_comment(c.get("text")) and (cut is None or (parse_ts(c.get("created_at")) or NOW) > cut)
    ]
    if not fresh:
        return [], None
    hint = f"/usr/local/bin/with-livespec-env.sh -- bd comments {epic} --json"
    lines = [f"comments {epic}: {len(fresh)} new rule comment(s) since {since or 'never'}"]
    for c in fresh:
        text = " | ".join(ln.strip() for ln in (c.get("text") or "").splitlines() if ln.strip())
        lines.append(f"  {c.get('created_at')} {c.get('author', '')}: {text[:RULES_COMMENT_CHARS]}")
        if len(text) > RULES_COMMENT_CHARS:
            lines.append(f"    +{len(text) - RULES_COMMENT_CHARS} more chars ({hint})")
    return lines, hint


def fit(parts, budget):
    """Share `budget` lines across the parts; a cut part ends with one '+N more lines' line."""
    sizes = [len(lines) for lines, _ in parts]
    alloc = [0] * len(parts)
    remaining = budget
    active = [i for i, size in enumerate(sizes) if size]
    while active and remaining > 0:
        share = max(1, remaining // len(active))
        for i in list(active):
            give = min(share, sizes[i] - alloc[i], remaining)
            alloc[i] += give
            remaining -= give
            if alloc[i] == sizes[i]:
                active.remove(i)
            if remaining == 0:
                break
    out = []
    for (lines, hint), size, keep in zip(parts, sizes, alloc):
        if keep >= size:
            out.extend(lines)
        elif keep > 0:
            out.extend(lines[: keep - 1])
            out.append(f"  +{size - keep + 1} more lines" + (f" ({hint})" if hint else ""))
    return out


def load_json(path):
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else None
    except (OSError, ValueError):
        return None


def save_json(path, data):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.replace(tmp, path)


def state_paths(seat):
    return (os.path.join(STATE_DIR, f"rules-ack-{seat}.json"), os.path.join(STATE_DIR, f"rules-seen-{seat}.json"))


def current_state(seat, warnings):
    """The watched sources as they stand now; an epic the ledger could not read maps to None."""
    ref = rules_ref(warnings)
    conf = SEATS[seat]
    comments = {epic: read_comments(epic) for epic in conf["epics"]}
    state = {
        "duties": blob_at(ref, DUTIES),
        "charters": {path: blob_at(ref, path) for path in conf["charters"]},
        "epics": {
            epic: (max((c.get("created_at") or "" for c in got), default="") if got is not None else None)
            for epic, got in comments.items()
        },
    }
    return ref, state, comments


def rules_changed(seat):
    """Print the RULES-CHANGED section and return its exit status (0, 3 or 4)."""
    ack_path, seen_path = state_paths(seat)
    warnings = []
    ack = load_json(ack_path)
    _, state, comments = current_state(seat, warnings)
    shown = {
        "duties": state["duties"],
        "charters": state["charters"],
        "epics": {e: ts for e, ts in state["epics"].items() if ts is not None},
        "seen_at": UTC_NOW,
    }
    try:
        save_json(seen_path, shown)
    except OSError as exc:
        warnings.append(f"WARNING: could not record the displayed state ({exc}); --ack will record the live state")
    if ack is None:
        for line in [NO_ACK_LINE] + [f"RULES-CHANGED {w}" for w in warnings]:
            print(line)
        print()
        return EXIT_RULES_CHANGED
    since = ack.get("acked_at", "?")
    parts = [blob_diff("duties", DUTIES, ack.get("duties"), state["duties"])]
    for epic, got in comments.items():
        if got is None:
            warnings.append(f"WARNING: ledger read failed for {epic}; its new rule comments are unknown")
            continue
        parts.append(comment_lines(epic, got, (ack.get("epics") or {}).get(epic) or since))
    for path, blob in state["charters"].items():
        parts.append(blob_diff("charter", path, (ack.get("charters") or {}).get(path), blob))
    parts = [p for p in parts if p[0]]
    unread = any("ledger read failed" in w for w in warnings)
    if not parts:
        head = f"RULES-CHANGED: none since ack {since}"
        if unread:
            head = f"RULES-CHANGED: unconfirmed since ack {since}; a rules source could not be read"
        for line in [head] + [f"  {w}" for w in warnings]:
            print(line)
        print()
        return EXIT_RULES_UNREAD if unread else 0
    head = (
        f"RULES-CHANGED (seat {seat}; since ack {since}; exit {EXIT_RULES_CHANGED} until acknowledged): read these"
        f" before ruling on anything, then run scripts/coordinator/top5 --seat {seat} --ack"
    )
    lines = [head] + [f"  {w}" for w in warnings]
    lines += fit(parts, RULES_MAX_LINES - len(lines))
    for line in lines:
        print(line)
    print()
    return EXIT_RULES_CHANGED


def rules_ack(seat):
    """Record the state the last run displayed (the live state where it displayed none)."""
    ack_path, seen_path = state_paths(seat)
    warnings = []
    old = load_json(ack_path) or {}
    seen = load_json(seen_path)
    if seen is None:
        _, live, _ = current_state(seat, warnings)
        seen = {"duties": live["duties"], "charters": live["charters"], "epics": live["epics"]}
    epics = {}
    for epic in SEATS[seat]["epics"]:
        stamp = (seen.get("epics") or {}).get(epic)
        if stamp is None:
            stamp = (old.get("epics") or {}).get(epic)
            warnings.append(f"WARNING: no readable comment state for {epic}; its previous ack is kept")
        epics[epic] = stamp
    record = {
        "seat": seat,
        "acked_at": UTC_NOW,
        "displayed_at": seen.get("seen_at"),
        "duties": seen.get("duties"),
        "charters": seen.get("charters") or {},
        "epics": epics,
    }
    save_json(ack_path, record)
    charters = ", ".join(f"{p} {short(b)}" for p, b in record["charters"].items())
    newest = ", ".join(f"{e} {s or 'none'}" for e, s in epics.items())
    print(f"RULES-ACK seat {seat} at {UTC_NOW}: duties {short(record['duties'])}; charter {charters}; epics {newest}")
    for w in warnings:
        print(f"  {w}")
    return 0


ARGS = parse_args()
if ARGS.ack:
    sys.exit(rules_ack(ARGS.seat))
RULES_EXIT = rules_changed(ARGS.seat)
if ARGS.rules_only:
    sys.exit(RULES_EXIT)

print(
    "INCIDENT MODE: livespec-dev-tooling USABLE (EXPEDITED_INCIDENT_RESPONSE is the default response to a red master;"
    " coordinator-duties §2). Not yet usable: livespec, orchestrator, overseer."
)
print()
overcommit_header()
stranded_header()
holds_header()


for label, epic in TOP:
    cwd, wrapper = repo_for(epic)
    rec = run(["bd", "show", epic, "--json"], cwd, wrapper)
    comments = run(["bd", "comments", epic, "--json"], cwd, wrapper) or []
    if not rec:
        print(f"{'P' if label[:1].isdigit() else ''}{label}: LEDGER READ FAILED ({epic})")
        continue
    r = rec[0]
    na = (r.get("metadata") or {}).get("next_action") or {}
    last = max([r.get("updated_at", "")] + [c.get("created_at", "") for c in comments])
    age = (NOW - dt.datetime.fromisoformat(last.replace("Z", "+00:00"))).total_seconds() / 60 if last else 1e9
    flag = ""
    if age > STALE_MINUTES:
        flag = "  <<< STALE: name the ONE next action and its holder; if it is the coordinator's, do it NOW"
    tag = "P" if label[:1].isdigit() else ""  # a KEPT seat is not a ranked priority
    print(f"{tag}{label} ({epic}) [{r['status']}] last ledger move {age:.0f} min ago{flag}")
    print(f"    next_action({na.get('kind')}): {na.get('text', '')[:220]}")
    if comments:
        newest = comments[-1]
        print(f"    newest comment {newest['created_at']}: {newest['text'][:220].replace(chr(10), ' ')}")

# Rule RULES-ACK: the full header is printed first, then the exit status carries RULES-CHANGED.
